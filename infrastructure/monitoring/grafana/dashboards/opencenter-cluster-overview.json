{
  "uid": "opencenter-cluster-overview",
  "title": "OpenCenter / Cluster Overview",
  "tags": [
    "opencenter",
    "cluster"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {}
      },
      {
        "name": "org",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(opencenter_deployment_info, org)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Organization",
        "current": {},
        "sort": 1
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(opencenter_deployment_info{org=~\"$org\"}, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Cluster",
        "current": {},
        "sort": 1
      },
      {
        "name": "region",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(opencenter_deployment_info{org=~\"$org\",cluster=~\"$cluster\"}, region)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Region",
        "current": {},
        "sort": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Namespace",
        "current": {},
        "sort": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(kube_node_info, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Node",
        "current": {},
        "sort": 1
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(opencenter_platform_service_ready, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Service",
        "current": {},
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Pod",
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 36,
      "type": "row",
      "title": "Executive health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Overall cluster health",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "avg(opencenter_cluster_node_ready{cluster=~\"$cluster\"})*100",
          "refId": "A",
          "legendFormat": "health"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ready / expected nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(opencenter_cluster_node_ready{cluster=~\"$cluster\"})",
          "refId": "A",
          "legendFormat": "ready"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running / total pods",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(opencenter_cluster_pods{cluster=~\"$cluster\",phase=\"running\"})",
          "refId": "A",
          "legendFormat": "running"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Flux ready resources",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(opencenter_flux_resource_ready{cluster=~\"$cluster\"})",
          "refId": "A",
          "legendFormat": "ready"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active critical alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or vector(0)",
