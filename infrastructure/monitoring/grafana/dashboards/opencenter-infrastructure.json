{
  "uid": "opencenter-infrastructure",
  "title": "OpenCenter / Infrastructure",
  "tags": [
    "opencenter",
    "infrastructure"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {}
      },
      {
        "name": "org",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(opencenter_deployment_info, org)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Organization",
        "current": {},
        "sort": 1
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(opencenter_deployment_info{org=~\"$org\"}, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Cluster",
        "current": {},
        "sort": 1
      },
      {
        "name": "region",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(opencenter_deployment_info{org=~\"$org\",cluster=~\"$cluster\"}, region)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Region",
        "current": {},
        "sort": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Namespace",
        "current": {},
        "sort": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(kube_node_info, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Node",
        "current": {},
        "sort": 1
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(opencenter_platform_service_ready, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Service",
        "current": {},
        "sort": 1
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "uid": "${datasource}"
        },
        "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "label": "Pod",
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 71,
      "type": "row",
      "title": "FLEX / OpenStack",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 67,
      "type": "timeseries",
      "title": "VM status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "opencenter_openstack_vm_status{org=~\"$org\",cluster=~\"$cluster\"}",
          "refId": "A",
          "legendFormat": "{{node}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 68,
      "type": "timeseries",
      "title": "Quota usage ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "opencenter_openstack_quota_usage_ratio{org=~\"$org\",cluster=~\"$cluster\"}",
          "refId": "A",
          "legendFormat": "{{resource}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 72,
      "type": "row",
      "title": "Cluster nodes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
    {
      "id": 69,
      "type": "timeseries",
      "title": "Node readiness",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "opencenter_cluster_node_ready{org=~\"$org\",cluster=~\"$cluster\"}",
          "refId": "A",
          "legendFormat": "{{node}} ({{role}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 70,
      "type": "timeseries",
      "title": "Pods by phase",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "expr": "opencenter_cluster_pods{org=~\"$org\",cluster=~\"$cluster\"}",
          "refId": "A",
          "legendFormat": "{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "annotations": {
    "list": []
  }
}
