# ============================================================
# ospc2flex_image_migrator environment example
# Copy to .env, edit values, then load with:
#
#   set -a
#   source ./.env
#   set +a
# ============================================================

# ------------------------------
# OpenRC files
# ------------------------------
OSPC_OPENRC="$HOME/ospc-openrc.sh"
FLEX_OPENRC="$HOME/flex-openrc.sh"

# ------------------------------
# Source VM
# ------------------------------
SOURCE_SERVER_NAME="web-01"

# Optional custom snapshot/image names
# SNAPSHOT_NAME="web-01-snap-manual"
# FLEX_IMAGE_NAME="web-01-flex-image"
# TEST_SERVER_NAME="web-01-lift-test"

# ------------------------------
# Workdir / format
# ------------------------------
WORKDIR="./image_migrator_work"
TARGET_FORMAT="qcow2"
# SOURCE_FORMAT="raw"

# ------------------------------
# FLEX image import
# ------------------------------
VISIBILITY="private"
CONTAINER_FORMAT="bare"

# ------------------------------
# FLEX test VM
# Required when using --boot-test-vm
# ------------------------------
FLEX_FLAVOR="gp.7.1.2"
FLEX_NETWORK_ID="REPLACE_WITH_FLEX_NETWORK_ID"
FLEX_KEY_NAME="REPLACE_WITH_FLEX_KEYPAIR_NAME"
FLEX_SECURITY_GROUP="default"

# Optional floating IP to associate to the test VM
# FLOATING_IP="203.0.113.25"

# ------------------------------
# SSH for guest repair
# Required when using --repair-guest
# ------------------------------
SSH_KEY_PATH="$HOME/.ssh/id_rsa"
SSH_USER="ubuntu"
SSH_PORT="22"

# Optional SSH jump host
# JUMP_HOST="ubuntu@jump.example.com"

# Optional known test VM IP if auto-discovery is not enough
# TEST_SERVER_IP="10.60.10.25"

# ------------------------------
# Guest repair toggles
# These are shell variables for your wrapper command logic.
# The Python tool itself uses flags, not env booleans.
# ------------------------------
NEW_HOSTNAME=""
FLEX_NET_IFACE="ens3"
SYSTEMD_SERVICES="nginx,myapp.service"

# Optional file for old|new endpoint substitutions
# APP_ENDPOINT_MAP_FILE="./app_endpoint_map.txt"

# ------------------------------
# Example wrapper commands
# ------------------------------

# 1) Dry run
# python3 ospc2flex_image_migrator.py \
#   --ospc-openrc "$OSPC_OPENRC" \
#   --flex-openrc "$FLEX_OPENRC" \
#   --server-name "$SOURCE_SERVER_NAME" \
#   --boot-test-vm \
#   --flex-flavor "$FLEX_FLAVOR" \
#   --flex-network-id "$FLEX_NETWORK_ID" \
#   --flex-key-name "$FLEX_KEY_NAME" \
#   --repair-guest \
#   --ssh-key-path "$SSH_KEY_PATH" \
#   --fix-fstab \
#   --dry-run

# 2) Real run with basic guest repair
# python3 ospc2flex_image_migrator.py \
#   --ospc-openrc "$OSPC_OPENRC" \
#   --flex-openrc "$FLEX_OPENRC" \
#   --server-name "$SOURCE_SERVER_NAME" \
#   --boot-test-vm \
#   --flex-flavor "$FLEX_FLAVOR" \
#   --flex-network-id "$FLEX_NETWORK_ID" \
#   --flex-key-name "$FLEX_KEY_NAME" \
#   --flex-security-group "$FLEX_SECURITY_GROUP" \
#   --repair-guest \
#   --ssh-key-path "$SSH_KEY_PATH" \
#   --ssh-user "$SSH_USER" \
#   --ssh-port "$SSH_PORT" \
#   --fix-fstab \
#   --fix-netplan \
#   --flex-net-iface "$FLEX_NET_IFACE" \
#   --clean-hosts-file \
#   --systemd-services "$SYSTEMD_SERVICES"

# 3) Real run with floating IP
# python3 ospc2flex_image_migrator.py \
#   --ospc-openrc "$OSPC_OPENRC" \
#   --flex-openrc "$FLEX_OPENRC" \
#   --server-name "$SOURCE_SERVER_NAME" \
#   --boot-test-vm \
#   --flex-flavor "$FLEX_FLAVOR" \
#   --flex-network-id "$FLEX_NETWORK_ID" \
#   --flex-key-name "$FLEX_KEY_NAME" \
#   --floating-ip "$FLOATING_IP" \
#   --repair-guest \
#   --ssh-key-path "$SSH_KEY_PATH"

# 4) With endpoint map file
# python3 ospc2flex_image_migrator.py \
#   --ospc-openrc "$OSPC_OPENRC" \
#   --flex-openrc "$FLEX_OPENRC" \
#   --server-name "$SOURCE_SERVER_NAME" \
#   --boot-test-vm \
#   --flex-flavor "$FLEX_FLAVOR" \
#   --flex-network-id "$FLEX_NETWORK_ID" \
#   --flex-key-name "$FLEX_KEY_NAME" \
#   --repair-guest \
#   --ssh-key-path "$SSH_KEY_PATH" \
#   --app-endpoint-map-file "$APP_ENDPOINT_MAP_FILE"
