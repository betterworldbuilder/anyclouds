        '      warn "  [Vol Attach] Volume $vol_name is in-use (not attached to $inst_name); skipping."; return 1',
        "    fi",
        '    if [[ "$vol_status" != "available" ]]; then',
        '      warn "  [Vol Attach] Volume $vol_name is $vol_status -- trial $attempt/$max_trials"',
