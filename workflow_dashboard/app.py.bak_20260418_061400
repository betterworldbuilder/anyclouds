        '    err "FAILED to create $kind: $name — check output above for reason"',
        '    if [[ "$kind" == "instance" ]]; then',
        '      warn "  Common blockers for instances:"',
        '      warn "    • Flavor disk too small for image (check \'minimum_disk\' in image metadata)"',
