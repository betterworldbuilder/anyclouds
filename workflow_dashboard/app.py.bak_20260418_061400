        "      fi",
        "      sleep 15; continue",
        "    fi",
        '    if server_has_volume "$inst_name" "$vol_name"; then',
        '      ok "Volume $vol_name already attached to $inst_name; skipping."; return 0',
        "    fi",
        '    vol_status=$(openstack volume show "$vol_name" -f value -c status 2>/dev/null || echo "UNKNOWN")',
