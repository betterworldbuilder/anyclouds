        "  done",
        '  err "TIMEOUT: Volume \'$name\' not available after ${max_sec}s"',
        "  return 1",
        "}",
        "",
        "volume_status() {",
        '  local name="$1"',
        '  openstack volume show "$name" -f value -c status 2>/dev/null || true',
