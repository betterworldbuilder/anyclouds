        '  log "🚀  $msg"',
        '  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"',
        "}",
        "",
        "# ── Guarded openstack wrapper ─────────────────────────────────────────────────",
