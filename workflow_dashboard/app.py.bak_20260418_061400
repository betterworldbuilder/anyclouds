        "err()  { echo \"[$(date '+%H:%M:%S')] ✖  $*\" >&2; DEPLOY_ERRORS=$((DEPLOY_ERRORS+1)); }",
        "ok()   { echo \"[$(date '+%H:%M:%S')] ✔  $*\"; DEPLOY_CREATED=$((DEPLOY_CREATED+1)); }",
