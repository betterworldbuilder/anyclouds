                <script>
                // Flavor map cross-linker — patches data-flavor on OSPC VM List checkboxes
                document.getElementById('flavor_map_file').addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        Papa.parse(evt.target.result, {
                            header: true, skipEmptyLines: true,
                            complete: function(results) {
                                // Build name → flavor lookup
                                const flavorLookup = {};
                                results.data.forEach(row => {
                                    const name = (row.source_server_name || row.server_name || row.name || '').toLowerCase().trim();
                                    const flavor = (row.target_flavor_name || row.target_flavor_id || row.flex_flavor || '').trim();
                                    if (name && flavor) flavorLookup[name] = flavor;
                                });

                                // Patch all vm-checkboxes + update visible Target Flavor cells
                                let patched = 0, missed = 0;
                                document.querySelectorAll('.vm-checkbox').forEach(cb => {
                                    const sname = (cb.dataset.sourceName || '').toLowerCase().trim();
                                    const flavor = flavorLookup[sname] || Object.entries(flavorLookup).find(([k]) => k.includes(sname) || sname.includes(k))?.[1];
                                    if (flavor) {
                                        cb.dataset.flavor = flavor;
                                        cb.title = `Flavor: ${flavor}`;
                                        // Update visible cell
                                        const cell = document.querySelector(`.flavor-cell[data-source-name="${cb.dataset.sourceName}"]`);
                                        if (cell) cell.textContent = flavor;
                                        patched++;
                                    } else {
                                        missed++;
                                    }
                                });

                                const statusEl = document.getElementById('flavorMapStatus');
                                statusEl.style.display = 'block';
                                if (patched > 0) {
                                    statusEl.innerHTML = `✅ Flavor map applied: <b>${patched}</b> VM(s) enriched with FLEX flavor${missed > 0 ? ` — ⚠️ ${missed} VM(s) not matched (check server names)` : ''}`;
                                    statusEl.style.borderColor = 'rgba(34,197,94,0.4)';
                                    statusEl.style.background = 'rgba(34,197,94,0.08)';
                                    statusEl.style.color = '#86efac';
                                } else {
                                    statusEl.innerHTML = `⚠️ No VMs matched. Ensure server names in flavormap align with the OSPC VM List. Rows found: ${results.data.length}`;
                                    statusEl.style.borderColor = 'rgba(234,179,8,0.4)';
                                    statusEl.style.background = 'rgba(234,179,8,0.08)';
                                    statusEl.style.color = '#fde047';
                                }
                            }
                        });
                    };
                    reader.readAsText(file);
                });
