                    // ── OSPC Scanner — identical logic to agent1.html discovery button ──
                    document.getElementById('vm-scan-btn').addEventListener('click', async () => {
                        const logEl  = document.getElementById('vm-scan-log');
                        const wrap   = document.getElementById('vm-scan-console-wrap');
                        const spinner = document.getElementById('vm-scan-spinner');
                        const btn    = document.getElementById('vm-scan-btn');
                        wrap.style.display = 'block';
                        spinner.style.display = 'inline';
                        logEl.textContent = 'Connecting to Engine...\n';

                        try {
                            const region     = document.getElementById('vm_scan_region').value;
                            // Exact same field IDs as agent1.html
                            const ospcUser   = (document.getElementById('ospc_cloud_user')    || {}).value || '';
                            const ospcApiKey = (document.getElementById('ospc_cloud_key')     || {}).value || '';
                            const ospcTenant = (document.getElementById('ospc_cloud_account') || {}).value || '';

                            if (!ospcUser || !ospcApiKey || !ospcTenant) {
                                logEl.textContent = '[ERROR] Missing OSPC credentials.\nPlease fill in OSPC Username, API Key, and Account/Tenant ID in the Credentials panel.';
                                spinner.style.display = 'none';
                                return;
                            }

                            btn.disabled = true; btn.textContent = '⏳ Scanning…';

                            const resp = await fetch('/api/agent1/run/discovery', {
                                method: 'POST',
                                headers: {'Content-Type': 'application/json'},
                                body: JSON.stringify({
                                    region:        region,
                                    ssh_user:      'ubuntu',
                                    ssh_key:       '',
                                    ospc_username: ospcUser,
                                    ospc_apikey:   ospcApiKey,
                                    ospc_tenant:   ospcTenant
                                })
                            });
                            const data = await resp.json();

                            if (data.status === 'started') {
                                let pollInterval = setInterval(async () => {
                                    try {
                                        let logReq = await fetch('/discovery_log.txt?t=' + new Date().getTime());
                                        if (logReq.ok) {
                                            let text = await logReq.text();
                                            logEl.textContent = text;
                                            logEl.parentElement.scrollTop = logEl.parentElement.scrollHeight;

                                            if (text.includes('Discovery complete!') || text.includes('Error:') || text.includes('Stopped')) {
                                                clearInterval(pollInterval);
                                                spinner.style.display = 'none';
                                                btn.disabled = false; btn.textContent = '🔍 Start OSPC Server Scan';
                                                // Load results CSV into VM table — same as agent1.html topology import
                                                try {
                                                    const cr = await fetch('/api/agent1/results/discovery_csv?t=' + Date.now());
                                                    if (cr.ok) {
                                                        const csvText = await cr.text();
                                                        // Push full scan results into table — no filtering
                                                        Papa.parse(csvText, { header: true, skipEmptyLines: true, complete: function(r) {
                                                            r.data.forEach(row => row['Source'] = 'scan');
                                                            if (!r.meta.fields.includes('Source')) r.meta.fields.unshift('Source');
                                                            flavorState.headers = r.meta.fields;
                                                            flavorState.rows = r.data;
                                                            flavorState.filtered = [...r.data];
                                                            document.getElementById('advFlavorContainer').style.display = 'block';
                                                            window._renderAdvTable(flavorState, 'flavor-table', 'mapperRowCount', false);
                                                            logEl.textContent += `\n✅ ${r.data.length} rows loaded from scan.`;
                                                        }});
                                                        logEl.textContent += '\n✅ VM table loaded from scan results.';
                                                    } else {
                                                        logEl.textContent += '\n[WARN] CSV fetch failed: ' + cr.status;
                                                    }
                                                } catch(e) {
                                                    logEl.textContent += '\n[ERROR] Table load failed: ' + e.message;
                                                }
                                            }
                                        }
                                    } catch(err) {}
                                }, 1000);
                            } else {
                                logEl.textContent += 'Status: ' + data.message;
                                spinner.style.display = 'none';
                                btn.disabled = false; btn.textContent = '🔍 Start OSPC Server Scan';
                            }
                        } catch(err) {
                            logEl.textContent = '[ERROR] Connection failed — is the backend running?\n' + err;
                            spinner.style.display = 'none';
                            btn.disabled = false; btn.textContent = '🔍 Start OSPC Server Scan';
                        }
                    });
