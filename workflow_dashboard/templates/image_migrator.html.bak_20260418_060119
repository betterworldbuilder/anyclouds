        function appendLog(text, type='info') {

            // __MANUAL_REPAIR_JSON__ sentinel removed — online repair replaced by Stage 4.5/4.6 offline repair
            if (text.includes('__MANUAL_REPAIR_JSON__')) return;

            const el = document.createElement('div');
            el.className = `log-line ${type}`;
            const ts = new Date().toLocaleTimeString();

            // Detect stage banner (### lines)
            if (text.startsWith('###') || text.startsWith('# ===')) {
                el.innerHTML = `<span style="color:#94a3b8">[${ts}]</span> <span style="color:#38bdf8;font-weight:bold;letter-spacing:1px">${text}</span>`;
            }
            // Stage header line (# [STAGE N])
            else if (/^# \[STAGE/.test(text) || /^# ===/.test(text)) {
                el.innerHTML = `<span style="color:#94a3b8">[${ts}]</span> <span style="color:#7dd3fc;font-weight:bold">${text}</span>`;
            }
            // Success result
            else if (text.includes('\u2705') || text.startsWith('[OK]')) {
                el.innerHTML = `<span style="color:#94a3b8">[${ts}]</span> <span style="color:#4ade80;font-weight:bold">${text}</span>`;
            }
            // Fatal / error
            else if (text.includes('[FATAL]') || text.includes('[ERROR]') || text.startsWith('\u2716')) {
                el.innerHTML = `<span style="color:#94a3b8">[${ts}]</span> <span style="color:#f87171;font-weight:bold">${text}</span>`;
            }
            // Warning
            else if (text.includes('[WARN]')) {
                el.innerHTML = `<span style="color:#94a3b8">[${ts}]</span> <span style="color:#fbbf24">${text}</span>`;
            }
            // System messages (batch control)
            else if (type === 'system') {
                el.innerHTML = `<span style="color:#94a3b8">[${ts}]</span> <span style="color:#38bdf8">${text}</span>`;
            }
            // Error type
            else if (type === 'error') {
                el.innerHTML = `<span style="color:#94a3b8">[${ts}]</span> <span style="color:#ff3366">${text}</span>`;
            }
            // Progress % lines — subtle
            else if (/^\s*\(\d+\.\d+\/100%\)/.test(text)) {
                el.innerHTML = `<span style="color:#475569;font-size:0.8em">${text}</span>`;
            }
            // Default info
            else {
                el.innerHTML = `<span style="color:#94a3b8">[${ts}]</span> <span style="color:#d1fae5">${text}</span>`;
            }

            consoleOut.appendChild(el);
            consoleOut.scrollTop = consoleOut.scrollHeight;
        }

