    var flavorState = { headers: [], rows: [], filtered: [], editMode: false };
    var blockState  = { headers: [], rows: [], filtered: [], editMode: false };

    // Global helpers needed by modal functions
    function escapeHTML(str) {
        return String(str||'').replace(/[&<>'"]/g, tag => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'}[tag]));
    }
    var VM_VISIBLE_COLS = ['service_type', 'name', 'public_ips', 'public_ipv4', 'external_ip'];

    document.addEventListener("DOMContentLoaded", () => {

        // Dedicated renderer preserving Frozen Checkbox bounds
        function renderAdvTable(state, tableId, countId, isBlock) {
            const table = document.getElementById(tableId);
            const counter = document.getElementById(countId);
            table.innerHTML = '';
            if(!state.headers.length) return;

            counter.textContent = `${state.filtered.length} rows`;

            // For VM table: only show the relevant columns + Target Flavor
            const visibleHeaders = isBlock
                ? state.headers
                : state.headers.filter(h => VM_VISIBLE_COLS.includes(h.toLowerCase().trim()));

