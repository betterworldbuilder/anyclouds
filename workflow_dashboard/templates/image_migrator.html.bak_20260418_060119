        function parseRemoteLine(raw, vmName) {
            let line = raw.replace(/^data:\s?/, '').trim();
            line = line.replace(/^\[REMOTE WORKER\]\s?/, '').trim();
            if (!line || line === '###############################################') return;
            const type = (line.includes('[ERROR]') || line.includes('FAILED') || line.includes('✖')) ? 'error'
                       : (line.includes('[OK]') || line.startsWith('✅')) ? 'success'
                       : (line.includes('[WARN]') || line.includes('[INFO]')) ? 'info'
                       : 'info';
            appendVmLog(vmName, line, type);
            // Removed mirror to shared console: no multiple terminal output confusion
        }


        const stopBtn = document.getElementById('stop-batch-btn');
