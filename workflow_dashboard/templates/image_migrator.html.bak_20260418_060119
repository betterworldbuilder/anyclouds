                // ── Credential localStorage keys ──────────────────────────────────────────
    const CRED_KEYS = {
      // OSPC — same field IDs as agent1.html
      ospc_cloud_user:    'cred_ospc_username',
      ospc_cloud_key:     'cred_ospc_apikey',
      ospc_cloud_account: 'cred_ospc_accountid',
      // FLEX
      credFlexAuthUrl:   'cred_flex_auth_url',
      credFlexUsername:  'cred_flex_username',
      credFlexPassword:  'cred_flex_password',
      credFlexProjectId: 'cred_flex_project_id',
      credFlexDomain:    'cred_flex_domain',
      credFlexRegion:    'cred_flex_region',
      credFlexAppCredId: 'cred_flex_app_cred_id',
      credFlexAppCredSecret: 'cred_flex_app_cred_secret',
    };

    // Load saved values on page init
    Object.entries(CRED_KEYS).forEach(([elId, lsKey]) => {
      const el = document.getElementById(elId);
      let saved = localStorage.getItem(lsKey);
      // ospc_cloud_account must be numeric — discard cached UUID values
      if (elId === 'ospc_cloud_account' && saved && /^[0-9a-f]{8}-[0-9a-f]{4}-/i.test(saved)) {
        localStorage.removeItem(lsKey);
        saved = null;
      }
      if (el && saved) {
        el.value = saved;
        // For select elements, also set the selectedIndex
        if (el.tagName === 'SELECT') {
          const opt = [...el.options].find(o => o.value === saved);
          if (opt) opt.selected = true;
        }
      }
    });
    // Default region to DFW if not set
    if (!localStorage.getItem('cred_flex_region')) {
      const regEl = document.getElementById('credFlexRegion');
      if (regEl) { regEl.value = 'DFW'; localStorage.setItem('cred_flex_region', 'DFW'); }
    }

    // Persist on every change
    Object.entries(CRED_KEYS).forEach(([elId, lsKey]) => {
      document.getElementById(elId)?.addEventListener('input', function () {
        localStorage.setItem(lsKey, this.value);
      });
      document.getElementById(elId)?.addEventListener('change', function () {
        localStorage.setItem(lsKey, this.value);
      });
    });


    // ── OpenRC file parser → FLEX fields + localStorage ───────────────────────
    document.getElementById('credOpenrcImportBtn')?.addEventListener('click', function() {
      const file = document.getElementById('credOpenrcFile')?.files?.[0];
      if (!file) { alert('Please select an OpenRC file first.'); return; }
      const reader = new FileReader();
      reader.onload = function(e) {
        const text = e.target.result.replace(/\r\n/g, '\n');  // normalise CRLF

        // Robust line-by-line parser — handles quoted/unquoted, with or without 'export'
        function parseOpenrc(src) {
          const map = {};
          src.split('\n').forEach(line => {
            // Strip leading whitespace and ignore comments
            const l = line.trim();
            if (!l || l.startsWith('#')) return;
            // Match:  [export] KEY=VALUE  (value may be quoted or bare, may have trailing comment)
            const m = l.match(/^(?:export\s+)?([A-Z_][A-Z0-9_]*)\s*=\s*(.*?)(?:\s+#.*)?$/);
            if (!m) return;
            let val = m[2].trim();
            // Strip wrapping single or double quotes
            if ((val.startsWith('"') && val.endsWith('"')) ||
                (val.startsWith("'") && val.endsWith("'"))) {
              val = val.slice(1, -1);
            }
            // Skip shell subshell values like $(...)
            if (val.startsWith('$(')) return;
            if (val) map[m[1]] = val;
          });
          return map;
        }

        const env = parseOpenrc(text);

        const vals = {
          credFlexAuthUrl:        env['OS_AUTH_URL']                       || '',
          credFlexUsername:       env['OS_USERNAME']                        || '',
          credFlexPassword:       env['OS_PASSWORD']                        || '',
          credFlexProjectId:      env['OS_PROJECT_ID']  || env['OS_TENANT_ID'] || '',
          credFlexDomain:         env['OS_USER_DOMAIN_NAME'] || env['OS_DOMAIN_NAME'] || env['OS_PROJECT_DOMAIN_NAME'] || 'rackspace_cloud_domain',
          credFlexAppCredId:      env['OS_APPLICATION_CREDENTIAL_ID']      || '',
          credFlexAppCredSecret:  env['OS_APPLICATION_CREDENTIAL_SECRET']  || '',
        };

        let filled = 0;
        Object.entries(vals).forEach(([id, val]) => {
          if (!val) return;
          const el = document.getElementById(id);
          if (el) { el.value = val; el.dispatchEvent(new Event('input')); filled++; }
          if (CRED_KEYS[id]) localStorage.setItem(CRED_KEYS[id], val);
        });

        // Show a quick toast
        const btn = document.getElementById('credOpenrcImportBtn');
        const orig = btn.textContent;
        btn.textContent = filled > 0 ? `✅ Filled ${filled} fields` : '⚠️ No values found';
        btn.style.background = filled > 0 ? 'linear-gradient(135deg,#16a34a,#22c55e)' : 'linear-gradient(135deg,#b45309,#f59e0b)';
        setTimeout(() => { btn.textContent = orig; btn.style.background = ''; }, 3000);
      };
      reader.readAsText(file);
    });
