            const block = document.getElementById('vm-block-' + safeId);
            const icons  = { running:'⏳', success:'✅', error:'❌', stopped:'⏹️' };
            const colors = { success:'#22c55e', error:'#ef4444', running:'#3b82f6', stopped:'#475569' };
            if (icon)  icon.textContent = icons[status] || '⏳';
            if (block && colors[status]) block.style.borderColor = colors[status];
            if (status !== 'running') {
                const timerEl = document.getElementById('vm-timer-' + safeId);
                if (timerEl) {
                    timerEl.dataset.stopped = 'true';
                    timerEl.style.color = '#94a3b8';
                    timerEl.style.borderColor = '#334155';
