        // Text parser for both manual uploads and auto-fetching
        function processCSVText(csvText, state, containerId, tableId, countId, isBlock) {
            Papa.parse(csvText, {
                header: true, skipEmptyLines: true,
                complete: function(results) {
                    document.getElementById(containerId).style.display = 'block';
                    state.headers = results.meta.fields || [];
                    
                    // Inject TCO Columns automatically if this is the Flavor mapper
                    if (!isBlock) {
                        if (!state.headers.includes("TCO_OSPC_Estimate")) state.headers.push("TCO_OSPC_Estimate");
                        if (!state.headers.includes("TCO_FLEX_Estimate")) state.headers.push("TCO_FLEX_Estimate");
                    }

                    state.rows = results.data;
                    
                    // Pre-fill default estimates if empty
                    if (!isBlock) {
                        state.rows.forEach(r => {
                            if (!r["TCO_OSPC_Estimate"]) r["TCO_OSPC_Estimate"] = "450.00";
                            if (!r["TCO_FLEX_Estimate"]) r["TCO_FLEX_Estimate"] = "300.00";
                        });
                    }

                    state.filtered = [...state.rows];
                    renderAdvTable(state, tableId, countId, isBlock);
                }
            });
        }
