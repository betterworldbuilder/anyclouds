        function generateFullMigrationCmd() {
            const g  = id => (document.getElementById(id) || {}).value || '';
            const gc = id => !!(document.getElementById(id) || {}).checked;

            // Read form settings
            const networkId    = g('flex_network_id')             || '<FLEX_NETWORK_ID>';
            const keyName      = g('flex_key_name') || g('flex_key_name_quick') || '<FLEX_KEY_NAME>';
            const sshKey       = g('process_ssh_key') || g('ssh_key_path') || '~/.ssh/id_rsa';
            const sshUser      = g('process_ssh_user') || g('ssh_user')   || 'ubuntu';
            const workdir      = g('workdir')                     || '~/OSPC2FLEX_WORKSPACE';
            const targetFormat = g('target_format')               || 'qcow2';
            const visibility   = g('visibility')                  || 'private';
            const extNet       = g('flex_external_network_name') || g('flex_external_network_input') || 'PUBLICNET';
            const bootTestVM   = gc('boot_test_vm');

            // Read checked VMs from batch table (same source the batch processor uses)
            const checkedBoxes = Array.from(document.querySelectorAll('.vm-checkbox:checked'));

            // Prefer inline inputs in the 1-liner block; fall back to batch checkboxes
            const inlineName   = (document.getElementById('ol_server_name') || {}).value?.trim();
            const inlineIP     = (document.getElementById('ol_source_ip')   || {}).value?.trim();
            const inlineFlavor = (document.getElementById('ol_flex_flavor') || {}).value?.trim();

            let vms;
            if (inlineName || inlineIP || inlineFlavor) {
                // Manual inline entry — single VM
                vms = [{ name: inlineName||'<SERVER_NAME>', ip: inlineIP||'<SOURCE_IP>', flavor: inlineFlavor||'<FLEX_FLAVOR>' }];
            } else if (checkedBoxes.length > 0) {
                // Pull from checked batch rows
                vms = checkedBoxes.map(cb => ({
                    name:   cb.dataset.sourceName || '<SERVER_NAME>',
                    ip:     cb.dataset.sourceIp   || '<SOURCE_IP>',
                    flavor: cb.dataset.flavor     || '<FLEX_FLAVOR>',
                }));
            } else {
                // Nothing filled — use placeholders and warn
                vms = [{ name: '<SERVER_NAME>', ip: '<SOURCE_IP>', flavor: '<FLEX_FLAVOR>' }];
                appendLog('⚠️ 1-Liner: Fill in Source VM Name, IP, and Flavor above — or check rows in the Flavor Mapper table.', 'system');
            }

            const MIGRATOR = '/home/dzoan/OSPC2FLEX/ospc2Flex-Image-migtool/ospc2flex_image_migrator.py';

            const cmds = vms.map(vm => {
                const parts = [
                    `python3 ${MIGRATOR}`,
                    `  --ospc-openrc ~/ospc.sh`,
                    `  --flex-openrc ~/flex.sh`,
                    `  --server-name ${vm.name}`,
                    `  --source-server-ip ${vm.ip}`,
                    `  --workdir ${workdir}`,
                    `  --target-format ${targetFormat}`,
                    `  --visibility ${visibility}`,
                    `  --remote-export`,
                    `  --ssh-key-path ${sshKey}`,
                    `  --ssh-user ${sshUser}`,
                ];
                if (bootTestVM) {
                    parts.push(`  --boot-test-vm`);
                    parts.push(`  --test-server-name OSPC2FLEX-TEST-VM`);
                    parts.push(`  --flex-flavor ${vm.flavor}`);
                    parts.push(`  --flex-network-id ${networkId}`);
                    parts.push(`  --flex-key-name ${keyName}`);
                    parts.push(`  --auto-floating-ip`);
                    parts.push(`  --flex-external-network ${extNet}`);
                }
                // Offline repair method — always included
                const repairMethod = (document.getElementById('offline_repair_method') || {}).value || 'custom_os';
                if (repairMethod === 'generic') parts.push(`  --offline-repair-method generic`);
                return parts.join(' \\\n');
            });

            const cmd = cmds.join('\n\n# ── Next VM ──\n');
            const el = document.getElementById('full-oneliner-display');
            el.textContent = cmd;
            window._fullOneLinerCmd = cmd;

