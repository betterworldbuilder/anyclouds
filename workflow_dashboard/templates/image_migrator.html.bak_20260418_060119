        // applyBlock removed (volume table removed)

        function applyFlavor(filename, content) {
            // Update label synchronously first — always visible
            const flbl = document.getElementById('flavor_map_label');
            if (flbl) flbl.innerHTML = `✅ <b style="color:#86efac;">${filename}</b>`;
            // Show status immediately
            const statusEl = document.getElementById('flavorMapStatus');
            if (statusEl) {
                statusEl.style.display = 'block';
                statusEl.innerHTML = `⏳ Applying flavor map: <b>${filename}</b>...`;
            }
            // Async parse and patch vm-checkboxes
            Papa.parse(content, {
                header: true, skipEmptyLines: true,
                complete: function(results) {
                    const flavorLookup = {};
                    results.data.forEach(row => {
                        const name   = (row.source_server_name || row.server_name || row.name || '').toLowerCase().trim();
                        const flavor = (row.target_flavor_name || row.target_flavor_id || row.flex_flavor || '').trim();
                        if (name && flavor) flavorLookup[name] = flavor;
                    });

                    // Store unique flavors globally for the Add VM modal datalist
                    window._flavorOptions = [...new Set(Object.values(flavorLookup).filter(Boolean))].sort();
                    const dl = document.getElementById('addVm_flavor_list');
                    if (dl) {
                        dl.innerHTML = window._flavorOptions.map(f => `<option value="${f}">`).join('');
                    }

                    // Re-render the full table so Target Flavor column populates immediately
                    // Store lookup globally so renderAdvTable can use it after re-render
                    window._flavorLookup = flavorLookup;
                    if (window._renderAdvTable && flavorState.rows.length) {
                        flavorState.rows.forEach(row => {
                            const key = (row.source_server_name || row.server_name || row.name || '').toLowerCase().trim();
                            const fl  = flavorLookup[key] ||
                                Object.entries(flavorLookup).find(([k]) => k.includes(key) || key.includes(k))?.[1];
                            if (fl) row._flex_flavor = fl;
                        });
                        flavorState.filtered = [...flavorState.rows];
                        window._renderAdvTable(flavorState, 'flavor-table', 'mapperRowCount', false);
                    }

                    let patched = 0, missed = 0;
                    document.querySelectorAll('.vm-checkbox').forEach(cb => {
                        const sname = (cb.dataset.sourceName || '').toLowerCase().trim();
                        const flavor = flavorLookup[sname] ||
                            Object.entries(flavorLookup).find(([k]) => k.includes(sname) || sname.includes(k))?.[1];
                        if (flavor) {
                            cb.dataset.flavor = flavor; cb.title = `Flavor: ${flavor}`;
                            const cell = document.querySelector(`.flavor-cell[data-source-name="${cb.dataset.sourceName}"]`);
                            if (cell) cell.textContent = flavor;
                            patched++;
                        } else missed++;
                    });
                    if (statusEl) {
                        if (patched > 0) {
                            statusEl.innerHTML = `✅ <b>${filename}</b> — ${patched} VM(s) enriched${missed > 0 ? ` — ⚠️ ${missed} VM(s) not matched (check server names)` : ''}`;
                            statusEl.style.cssText += ';border-color:rgba(34,197,94,0.4);background:rgba(34,197,94,0.08);color:#86efac;';
                        } else if (results.data.length > 0) {
                            statusEl.innerHTML = `✅ <b>${filename}</b> loaded (${results.data.length} rows) — VMs will be matched when table loads`;
                            statusEl.style.cssText += ';border-color:rgba(59,130,246,0.4);background:rgba(59,130,246,0.08);color:#93c5fd;';
                        }
                    }
                    setTimeout(autoFillOneLinerInputs, 50);
                }
            });
        }

        function autoFillOneLinerInputs() {
            // Only fill if the user hasn't typed anything manually
            const nameEl   = document.getElementById('ol_server_name');
            const ipEl     = document.getElementById('ol_source_ip');
            const flavorEl = document.getElementById('ol_flex_flavor');
            if (!nameEl || !ipEl || !flavorEl) return;

            // Try checked batch checkboxes first
            const checked = Array.from(document.querySelectorAll('.vm-checkbox:checked'));
            if (checked.length > 0) {
                const first = checked[0];
                if (!nameEl.value)   nameEl.value   = first.dataset.sourceName || '';
                if (!ipEl.value)     ipEl.value     = first.dataset.sourceIp   || '';
                if (!flavorEl.value) flavorEl.value = first.dataset.flavor     || '';
                return;
            }

            // Fall back to first row in flavorState (overview CSV data)
            const rows = flavorState.filtered || flavorState.rows || [];
            if (rows.length === 0) return;
            const first = rows[0];

            const sname  = first.source_server_name || first.server_name || first.name || '';
            // public_ips may contain multiple IPs separated by ; — take first
            const rawIP  = first.public_ips || first.external_ip || first.source_server_ip || '';
            const ip     = rawIP.split(/[;,\s]+/).map(s => s.trim()).find(s => s) || '';
            // Flavor from checkbox dataset if matched, else from row
            const cb     = document.querySelector(`.vm-checkbox[data-source-name="${sname}"]`);
            const flavor = (cb && cb.dataset.flavor) || first.flex_flavor || first.target_flavor_name || '';

            if (sname  && !nameEl.value)   nameEl.value   = sname;
            if (ip     && !ipEl.value)     ipEl.value     = ip;
            if (flavor && !flavorEl.value) flavorEl.value = flavor;
        }

