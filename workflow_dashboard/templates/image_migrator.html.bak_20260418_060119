                    try {
                        const response = await fetch('/api/vm_migrator/nbd/run_single', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify(payload)
                        });

                        if (!response.ok) {
                            const errText = await response.text();
                            appendLog(`✖ [${sName}] Server error ${response.status}: ${errText.substring(0,200)}`, 'error');
                            setVmStatus(sName, 'error');
                            return;
                        }

                        reader = response.body.getReader();
                        window.activeBatchReaders.push(reader);
                        const decoder = new TextDecoder();

                        while (isBatchRunning) {
                            const {done, value} = await reader.read();
                            if (done) break;

                            let chunk = decoder.decode(value);
                            chunk.split(/\n/).forEach(rawLine => {
                                if (!rawLine.trim()) return;
                                if (rawLine.startsWith('data: ') || rawLine.startsWith('[REMOTE WORKER]')) {
                                    const content = rawLine.replace(/^data:\s?/,'').trim();
                                    if (!content || content === '[DONE]') return;
                                    appendVmLog(sName, content, 'system');
                                    if (content.includes('[ERROR]') || content.includes('FAILED') || content.includes('LAUNCH ERROR')) {
                                        appendLog(`[${sName}] ${content}`, 'error');
                                    }
                                    if (content.includes('SSH OK') || content.includes('BOOT_TEST_OK')) {
                                        setVmStatus(sName, 'success');
                                    }
                                } else if (rawLine.startsWith('[')) {
                                    appendVmLog(sName, rawLine.trim(), 'system');
                                }
                            });
                        }

                        if (isBatchRunning) {
                            appendLog(`✔ Finished NBD migration: ${sName}`, 'system');
                        }
                    } catch (e) {
                        if (isBatchRunning) { appendLog(`✖ NBD FAILED ${sName}: ${e.message}`, 'error'); setVmStatus(sName, 'error'); }
                    } finally {
                        if (reader) {
                            const ri = window.activeBatchReaders.indexOf(reader);
                            if (ri !== -1) window.activeBatchReaders.splice(ri, 1);
                        }
                    }
                });

                await Promise.all(promises);

            } else {

            // ────────────────────────────────────────────────────────────────
            // STANDARD PATH: custom_os / generic -> ospc2flex_image_migrator.py
            // ────────────────────────────────────────────────────────────────
            const promises = Array.from(checkedVMs).map(async (cb, i) => {
                if (!isBatchRunning) return;
                const sName = cb.dataset.sourceName;
                const tName = cb.dataset.targetName;
                const flavor = cb.dataset.flavor;
                const sourceIpOverride = cb.dataset.sourceIp;
                const vmSshUser = cb.dataset.sshUser || null;
                
                appendLog(`► BATCH [${i+1}/${checkedVMs.length}]: Dispatching VM '${sName}' -> FLEX '${tName}' with flavor '${flavor}'...`, 'system');

                // Clone payload and inject VM specifics
                const payload = Object.assign({}, payloadTemplate);
                payload.server_name = sName;
                payload.flex_flavor = flavor;
                if (sourceIpOverride) payload.source_server_ip = sourceIpOverride;
                if (vmSshUser) payload.ssh_user = vmSshUser;  // per-VM override
                payload.test_server_name = (tName && tName !== 'Unknown') ? tName + "-lift-test" : "OSPC2FLEX-TEST-VM";
                
                setVmStatus(sName, 'running');
                let reader = null;
                try {
                    // Trigger the POST stream and unspool directly
                    const response = await fetch('/api/image_migrator/run', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        const errText = await response.text();
                        appendLog(`✖ [${sName}] Server error ${response.status}: ${errText.substring(0,200)}`, 'error');
                        setVmStatus(sName, 'error');
                        return;
                    }

                    reader = response.body.getReader();
                    window.activeBatchReaders.push(reader);
                    const decoder = new TextDecoder();

                    while (isBatchRunning) {
                        const {done, value} = await reader.read();
                        if (done) break;

                        let chunk = decoder.decode(value);
                        // Split on SSE newlines
                        chunk.split(/\n/).forEach(rawLine => {
                            if (!rawLine.trim()) return;
                            if (rawLine.startsWith('data: ') || rawLine.startsWith('[REMOTE WORKER]')) {
                                parseRemoteLine(rawLine, sName);
                                // Mirror errors to main console
                                const content = rawLine.replace(/^data:\s?/,'').trim();
                                if (content.includes('[ERROR]') || content.includes('FAILED') || content.includes('LAUNCH ERROR') || content.includes('PROCESS EXITED WITH CODE') && !content.includes('CODE 0')) {
                                    appendLog(`[${sName}] ${content}`, 'error');
                                }
                            } else if (rawLine.startsWith('[')) {
                                appendVmLog(sName, rawLine.trim(), 'system');
                            }
                        });
                    }
                    
                    if (isBatchRunning) {
                        appendLog(`✔ Finished processing VM: ${sName}`, 'system');
                        setVmStatus(sName, 'success');
                    }
                } catch (e) {
                    if (isBatchRunning) { appendLog(`✖ FAILED processing VM ${sName}: ${e.message}`, 'error'); setVmStatus(sName, 'error'); }
                } finally {
                    if (reader) {
                        const idx = window.activeBatchReaders.indexOf(reader);
                        if (idx !== -1) window.activeBatchReaders.splice(idx, 1);
                    }
                }
            });

            await Promise.all(promises);
            
            if (isBatchRunning) {
                appendLog("=== Batch Migration Complete ===", 'system');
                
                const mainTimer = document.getElementById('main-timer');
                if (mainTimer) {
                    mainTimer.dataset.stopped = 'true';
                    mainTimer.style.color = '#94a3b8';
                    mainTimer.style.borderColor = '#334155';
                }
                
                startBtn.style.display = 'flex';
                stopBtn.style.display = 'none';
                isBatchRunning = false;
            }
        });
        
        // Auto-save & hydrate credentials via localStorage mapping
        const FIELD_DEFAULTS = {
            'flex_key_name': 'laptopubuntu24',
            'flex_key_name_quick': 'laptopubuntu24',
            'process_ssh_user': 'ubuntu',
            'workdir': '/mnt/migration/ospc2flex_image',
            'process_ssh_key': '~/.ssh/id_rsa'
        };
        // lsKey mapping — nbd_jumphost_* share the same key as process_* so both panels stay in sync
        const credIdKeyMap = {
            'flex_key_name_quick':       'mig_flex_key_name',
            'flex_external_network_name':'mig_flex_ext_net',
            'nbd_jumphost_ip':           'mig_process_host_ip',
            'nbd_jumphost_user':         'mig_process_ssh_user',
            'nbd_jumphost_key':          'mig_process_ssh_key',
        };
        const credIds = [
            'ospc_cloud_user', 'ospc_cloud_key', 'ospc_cloud_account',
            'credFlexAuthUrl', 'credFlexUsername', 'credFlexPassword', 'credFlexProjectId', 'credFlexDomain',
            'flex_network_id', 'flex_key_name', 'flex_key_name_quick', 'flex_external_network_name',
            'process_host_ip', 'workdir', 'process_ssh_user', 'process_ssh_key',
            'nbd_jumphost_ip', 'nbd_jumphost_user', 'nbd_jumphost_key'
        ];
        credIds.forEach(id => {
            const el = document.getElementById(id);
            if(el) {
                const lsKey = credIdKeyMap[id] || ('mig_' + id);
                let saved = localStorage.getItem(lsKey);
                // Clear stale keypair name
                if ((id === 'flex_key_name' || id === 'flex_key_name_quick') && saved === 'ospc2flex') {
                    saved = null; localStorage.removeItem(lsKey);
                }
                // Clear stale workdir
                if (id === 'workdir' && saved === '/home/ubuntu/image') {
                    saved = null; localStorage.removeItem(lsKey);
                }
                // Clear jumphost IP if it contains non-IP text (e.g. leaked table content)
                if ((id === 'process_host_ip' || id === 'nbd_jumphost_ip') && saved && !/^\d{1,3}\.\d{1,3}/.test(saved)) {
                    saved = null; localStorage.removeItem(lsKey);
                }
                if(saved) {
                    el.value = saved;
                    if (id === 'flex_external_network_name') {
                        const q = document.getElementById('flex_external_network_input');
                        if (q) q.value = saved;
                    }
                } else if (FIELD_DEFAULTS[id]) {
                    el.value = FIELD_DEFAULTS[id];
                    localStorage.setItem(lsKey, FIELD_DEFAULTS[id]);
                }
                el.addEventListener('input', () => {
                    localStorage.setItem(lsKey, el.value);
                    // Keep quick and full keypair fields in sync
                    if (id === 'flex_key_name_quick') {
                        const full = document.getElementById('flex_key_name');
                        if (full) full.value = el.value;
                    } else if (id === 'flex_key_name') {
                        const quick = document.getElementById('flex_key_name_quick');
                        if (quick) quick.value = el.value;
                    }
                    // Keep main panel and NBD panel jumphost fields in sync
                    const syncMap = {
                        'process_host_ip':  'nbd_jumphost_ip',   'nbd_jumphost_ip':  'process_host_ip',
                        'process_ssh_user': 'nbd_jumphost_user', 'nbd_jumphost_user':'process_ssh_user',
                        'process_ssh_key':  'nbd_jumphost_key',  'nbd_jumphost_key': 'process_ssh_key',
                    };
                    const mirror = document.getElementById(syncMap[id]);
                    if (mirror) mirror.value = el.value;
                });
            }
        });

        // --- Restore offline repair method dropdown ---
        (function() {
            const sel = document.getElementById('offline_repair_method');
            if (sel) {
                const saved = localStorage.getItem('mig_offline_repair_method');
                if (saved) sel.value = saved;
            }
        })();

        // --- Active OS Discovery Execution ---
        const osDiscBtn = document.getElementById('runOSDiscoveryBtn');
        if(osDiscBtn) {
            osDiscBtn.addEventListener('click', async () => {
                const fileInput = document.getElementById('inventory_csv_for_discovery');
                const file = fileInput.files[0];
                if(!file) { alert("Please select an Inventory or Overview CSV first to provide IPs."); return; }
                
                const originalText = osDiscBtn.textContent;
                osDiscBtn.textContent = "Uploading & Parsing...";
                osDiscBtn.disabled = true;
                
                const reader = new FileReader();
                reader.onload = async (e) => {
                    try {
                        const content = e.target.result;
                        const uploadRes = await fetch('/api/save-csv', {
                            method: 'POST',
                            body: JSON.stringify({target_name: file.name, content: content})
                        });
                        const uploadData = await uploadRes.json();
                        if(!uploadData.ok) throw new Error("Upload failed: " + uploadData.error);
                        
                        osDiscBtn.textContent = "Generating Scanner Script...";
                        const genRes = await fetch('/api/run/generate-app-dependencies', {
                            method: 'POST',
                            body: JSON.stringify({overview_csv: uploadData.saved_path, mode: 'active'})
                        });
                        const genData = await genRes.json();
                        if(!genData.ok) throw new Error("Generation failed: " + genData.error);
                        
                        osDiscBtn.textContent = "Extracting via SSH (Takes time)...";
                        consoleOut.innerHTML = ''; // Clear terminal for Active OS scanner stream
                        appendLog("Starting Active OS Dependency Scanner. This will SSH into source servers...", 'system');
                        
                        const scriptName = file.name.replace('.csv', '').replace('_overview', '').replace('_inventory', '') + '_active_dependency_scanner.sh';
                        const execRes = await fetch('/api/stream/execute-bash?script=uploads/' + scriptName);
                        
                        const execReader = execRes.body.getReader();
                        const decoder = new TextDecoder();
                        while (true) {
                            const {done, value} = await execReader.read();
                            if (done) break;
                            const textChunk = decoder.decode(value);
                            textChunk.split('\\n').forEach(line => {
                                if(line.startsWith('data: ') && line.trim() !== 'data:') {
                                    appendLog(`[Discovery] ${line.replace('data: ','').trim()}`);
                                }
                            });
                        }
                        
                        osDiscBtn.textContent = "Parsing Results...";
                        const parseRes = await fetch('/api/run/parse-active-logs');
                        const parseData = await parseRes.json();
                        if(!parseData.ok) throw new Error("Parse failed: " + parseData.error);
                        
                        const tbody = document.getElementById('os-discovery-tbody');
                        tbody.innerHTML = '';
                        parseData.data.forEach(row => {
                            tbody.innerHTML += `<tr>
                                <td>${escapeHTML(row.hostname)}</td>
                                <td>${escapeHTML(row.os_version)}</td>
                                <td>${escapeHTML(row.packages)}</td>
                                <td>${escapeHTML(row.runtimes)}</td>
                                <td>${escapeHTML(row.environments)}</td>
                            </tr>`;
                        });
                        document.getElementById('osDiscoveryTableWrap').style.display = 'block';
                        appendLog("Active OS Discovery completed and parsed.", 'system');
                    } catch(err) {
                        alert(err.message);
                        appendLog(err.message, 'error');
                    }
                    osDiscBtn.disabled = false;
                    osDiscBtn.textContent = "Refresh Discovery Data";
                };
                reader.readAsText(file);
            });
        }
    });
    </script>

    <!-- ── NBD Inline Repair Migration Logic ──────────────────────────────── -->
    <script>
    // OS defaults for NBD migration
    const NBD_OS_DEFAULTS = {
        ubuntu24: { src_user:'ubuntu',    flex_user:'ubuntu',    nbd:0, src_port:10811, tun_port:10821 },
        ubuntu22: { src_user:'ubuntu',    flex_user:'ubuntu',    nbd:0, src_port:10811, tun_port:10821 },
        ubuntu:   { src_user:'ubuntu',    flex_user:'ubuntu',    nbd:0, src_port:10811, tun_port:10821 },
        debian11: { src_user:'root',      flex_user:'root',      nbd:3, src_port:10814, tun_port:10824 },
        debian10: { src_user:'root',      flex_user:'root',      nbd:3, src_port:10814, tun_port:10824 },
        debian:   { src_user:'root',      flex_user:'root',      nbd:3, src_port:10814, tun_port:10824 },
        rocky8:   { src_user:'root',      flex_user:'rocky',     nbd:2, src_port:10813, tun_port:10823 },
        rocky9:   { src_user:'rocky',     flex_user:'rocky',     nbd:2, src_port:10813, tun_port:10823 },
        alma9:    { src_user:'almalinux', flex_user:'almalinux', nbd:1, src_port:10812, tun_port:10822 },
        alma8:    { src_user:'almalinux', flex_user:'almalinux', nbd:1, src_port:10812, tun_port:10822 },
        centos7:  { src_user:'centos',    flex_user:'centos',    nbd:1, src_port:10812, tun_port:10822 },
        rhel8:    { src_user:'ec2-user',  flex_user:'ec2-user',  nbd:2, src_port:10813, tun_port:10823 },
    };

    function toggleNbdPanel() {
        const method = (document.getElementById('offline_repair_method') || {}).value;
        const panel  = document.getElementById('nbd-panel');
        if (panel) panel.style.display = (method === 'nbd_inline') ? 'block' : 'none';
        // ── Dynamic button label per repair mode ──
        const lbl = document.getElementById('start-btn-label');
        if (lbl) {
            const labels = {
                'custom_os':  '\u25b6 Start Migration Batch (Per OS Type)',
                'generic':    '\u2699 Start Migration Batch (Generic Offline)',
                'nbd_inline': '\ud83d\ude80 Start Migration Batch (NBD Inline Repair)',
            };
            lbl.textContent = labels[method] || labels['custom_os'];
        }
        // ── Button color glow per mode ──
        const btn = document.getElementById('start-batch-btn');
        if (btn) {
            if (method === 'nbd_inline') {
                btn.style.background = 'linear-gradient(135deg, #0ea5e9, #2563eb)';
                btn.style.borderColor = '#38bdf8';
            } else if (method === 'generic') {
                btn.style.background = 'linear-gradient(135deg, #f59e0b, #d97706)';
                btn.style.borderColor = '#fbbf24';
            } else {
                btn.style.background = '';
                btn.style.borderColor = '';
            }
        }
    }

    // Guess OS type from a label string
    function guessOsType(label) {
        const l = (label || '').toLowerCase();
        if (l.includes('ubuntu24') || l.includes('u24')) return 'ubuntu24';
        if (l.includes('ubuntu22') || l.includes('u22')) return 'ubuntu22';
        if (l.includes('ubuntu'))  return 'ubuntu';
        if (l.includes('debian11')) return 'debian11';
        if (l.includes('debian10') || l.includes('debian')) return 'debian10';
        if (l.includes('rocky8') || l.includes('rocky'))    return 'rocky8';
        if (l.includes('alma9')  || l.includes('almalinux')) return 'alma9';
        if (l.includes('centos')) return 'centos7';
        if (l.includes('rhel'))   return 'rhel8';
        return 'ubuntu24';
    }

    function nbdMakeRow(label='', src_ip='', os_type='ubuntu24') {
        const d = NBD_OS_DEFAULTS[os_type] || NBD_OS_DEFAULTS.ubuntu24;
        const id = 'nbd-row-' + Date.now() + Math.random().toString(36).slice(2,6);
        const osOpts = Object.keys(NBD_OS_DEFAULTS).map(k =>
            `<option value="${k}" ${k===os_type?'selected':''}>${k}</option>`).join('');
        return `<tr id="${id}" style="border-bottom:1px solid #0f172a;">
            <td style="padding:4px 6px;"><input value="${label}" style="width:110px;background:#0f172a;border:1px solid #334155;border-radius:4px;color:#e2e8f0;font-size:11px;padding:3px 6px;" class="nbd-label"></td>
            <td style="padding:4px 6px;"><input value="${src_ip}" style="width:130px;background:#0f172a;border:1px solid #334155;border-radius:4px;color:#e2e8f0;font-size:11px;padding:3px 6px;" class="nbd-src-ip"></td>
            <td style="padding:4px 6px;"><select onchange="nbdOsChange(this,'${id}')" style="background:#0f172a;border:1px solid #334155;border-radius:4px;color:#38bdf8;font-size:11px;padding:3px 4px;" class="nbd-os-type">${osOpts}</select></td>
            <td style="padding:4px 6px;"><input value="${d.src_user}" style="width:80px;background:#0f172a;border:1px solid #334155;border-radius:4px;color:#e2e8f0;font-size:11px;padding:3px 6px;" class="nbd-src-user"></td>
            <td style="padding:4px 6px;"><input value="${d.flex_user}" style="width:80px;background:#0f172a;border:1px solid #334155;border-radius:4px;color:#e2e8f0;font-size:11px;padding:3px 6px;" class="nbd-flex-user"></td>
            <td style="padding:4px 6px;"><input value="${d.nbd}" style="width:36px;background:#0f172a;border:1px solid #334155;border-radius:4px;color:#fbbf24;font-size:11px;padding:3px 4px;text-align:center;" class="nbd-nbd-idx"></td>
            <td style="padding:4px 6px;"><input value="${d.src_port}" style="width:55px;background:#0f172a;border:1px solid #334155;border-radius:4px;color:#e2e8f0;font-size:11px;padding:3px 4px;text-align:center;" class="nbd-src-port"></td>
            <td style="padding:4px 6px;"><input value="${d.tun_port}" style="width:55px;background:#0f172a;border:1px solid #334155;border-radius:4px;color:#e2e8f0;font-size:11px;padding:3px 4px;text-align:center;" class="nbd-tun-port"></td>
            <td style="padding:4px 8px;"><span id="nbd-status-${id}" style="color:#64748b;font-size:11px;">⏳ pending</span></td>
            <td style="padding:4px 4px;"><button onclick="document.getElementById('${id}').remove()" style="background:none;border:none;color:#475569;cursor:pointer;font-size:14px;">✕</button></td>
        </tr>`;
    }

    function nbdOsChange(sel, rowId) {
        const row = document.getElementById(rowId);
        if (!row) return;
        const os = sel.value;
        const d  = NBD_OS_DEFAULTS[os] || NBD_OS_DEFAULTS.ubuntu24;
        row.querySelector('.nbd-src-user').value  = d.src_user;
        row.querySelector('.nbd-flex-user').value = d.flex_user;
        row.querySelector('.nbd-nbd-idx').value   = d.nbd;
        row.querySelector('.nbd-src-port').value  = d.src_port;
        row.querySelector('.nbd-tun-port').value  = d.tun_port;
    }

    function nbdAddRow(label, src_ip, os_type) {
        const tbody = document.getElementById('nbd-vm-tbody');
        if (!tbody) return;
        tbody.insertAdjacentHTML('beforeend', nbdMakeRow(label||'', src_ip||'', os_type||'ubuntu24'));
    }

    function nbdImportFromTable() {
        // Read checked VMs from the Flavor Mapper table
        const checked = document.querySelectorAll('.vm-select-cb:checked, input[data-vm-checkbox]:checked, .batch-vm-checkbox:checked');
        if (!checked.length) { alert('No VMs checked in the Flavor Mapper table above.'); return; }
        checked.forEach(cb => {
            const row = cb.closest('tr');
            if (!row) return;
            const cells = row.querySelectorAll('td');
            const label = (cells[1] && cells[1].textContent.trim()) || '';
            const src_ip = (cells[2] && cells[2].textContent.trim()) || '';
            const os_type = guessOsType(label);
            nbdAddRow(label, src_ip, os_type);
        });
    }

    function nbdGetVms() {
        const rows = document.querySelectorAll('#nbd-vm-tbody tr');
        const vms  = [];
        rows.forEach(row => {
            const label     = (row.querySelector('.nbd-label')     || {}).value || '';
            const src_ip    = (row.querySelector('.nbd-src-ip')    || {}).value || '';
            const os_type   = (row.querySelector('.nbd-os-type')   || {}).value || 'ubuntu24';
            const src_user  = (row.querySelector('.nbd-src-user')  || {}).value || '';
            const flex_user = (row.querySelector('.nbd-flex-user') || {}).value || '';
            const nbd_idx   = parseInt((row.querySelector('.nbd-nbd-idx')  || {}).value || '0');
            const src_port  = parseInt((row.querySelector('.nbd-src-port') || {}).value || '10811');
            const tun_port  = parseInt((row.querySelector('.nbd-tun-port') || {}).value || '10821');
            if (label && src_ip) vms.push({ label, src_ip, os_type, src_user, flex_user, nbd_idx, src_port, tun_port });
        });
        return vms;
    }

    function nbdGetJumphostParams() {
        // Prefer the dedicated NBD panel fields; fall back to the main jumphost section
        const jh   = (document.getElementById('nbd_jumphost_ip')   || {}).value
                  || (document.getElementById('process_host_ip')   || {}).value || '';
        const user = (document.getElementById('nbd_jumphost_user') || {}).value
                  || (document.getElementById('process_ssh_user')  || {}).value || 'ubuntu';
        const key  = (document.getElementById('nbd_jumphost_key')  || {}).value
                  || (document.getElementById('process_ssh_key')   || {}).value || '~/.ssh/id_rsa';
        return { jumphost_ip: jh.trim(), jumphost_user: user.trim(), ssh_key_path: key.trim() };
    }

    function nbdGetFlexCreds() {
        return {
            username:   (document.getElementById('credFlexUsername')   || {}).value || '',
            password:   (document.getElementById('credFlexPassword')   || {}).value || '',
            auth_url:   (document.getElementById('credFlexAuthUrl')    || {}).value || 'https://keystone.api.dfw3.rackspacecloud.com/v3/',
            region:     (document.getElementById('credFlexRegion')     || {}).value || 'DFW3',
            project_id: (document.getElementById('credFlexProjectId')  || {}).value || '',
            domain:     (document.getElementById('credFlexDomain')     || {}).value || 'rackspace_cloud_domain',
        };
    }

    function nbdCreateTerminal(label) {
        const termId = 'nbd-term-' + label;
        if (document.getElementById(termId)) return;
        const wrap = document.createElement('div');
        wrap.id = termId;
        wrap.style.cssText = 'background:#060a10;border:1px solid #1e3a5f;border-radius:10px;overflow:hidden;';
        wrap.innerHTML = `
            <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 14px;background:#0a1628;border-bottom:1px solid #1e3a5f;">
                <span style="color:#38bdf8;font-weight:700;font-size:13px;">⚡ ${label}</span>
                <span id="nbd-term-status-${label}" style="color:#64748b;font-size:11px;">running…</span>
            </div>
            <div id="nbd-term-body-${label}" style="height:220px;overflow-y:auto;padding:10px 14px;font-family:monospace;font-size:11px;color:#94a3b8;line-height:1.5;"></div>`;
        document.getElementById('nbd-terminals').appendChild(wrap);
    }

    function nbdAppendLog(label, text) {
        const body = document.getElementById(`nbd-term-body-${label}`);
        if (!body) return;
        const el = document.createElement('div');
        const esc = s => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        const s = esc(text);
        if (text.includes('SSH OK'))        el.innerHTML = `<span style="color:#4ade80;font-weight:bold">${s}</span>`;
        else if (text.includes('SSH FAIL') || text.includes('ERROR')) el.innerHTML = `<span style="color:#f87171;font-weight:bold">${s}</span>`;
        else if (text.includes('Step '))    el.innerHTML = `<span style="color:#38bdf8">${s}</span>`;
        else if (text.includes('[NET]') || text.includes('[MOUNT]')) el.innerHTML = `<span style="color:#a78bfa">${s}</span>`;
        else if (text.includes('[FSCK]') || text.includes('[GPT]'))  el.innerHTML = `<span style="color:#64748b;font-size:10px">${s}</span>`;
        else el.innerHTML = `<span>${s}</span>`;
        body.appendChild(el);
        body.scrollTop = body.scrollHeight;
    }

    function nbdStreamLog(label, jumphostIp, jumphostUser, sshKey) {
        const url = `/api/vm_migrator/nbd/stream?jumphost_ip=${encodeURIComponent(jumphostIp)}&jumphost_user=${encodeURIComponent(jumphostUser)}&ssh_key=${encodeURIComponent(sshKey)}&label=${encodeURIComponent(label)}`;
        const es  = new EventSource(url);
        es.onmessage = e => {
            const txt = e.data;
            if (txt === '[DONE]') { es.close(); return; }
            nbdAppendLog(label, txt);
            const statusEl = document.getElementById(`nbd-term-status-${label}`);
            if (txt.includes('SSH OK')) {
                if (statusEl) { statusEl.textContent = '✅ SSH OK'; statusEl.style.color = '#4ade80'; }
                nbdUpdateRowStatus(label, '✅ SSH OK', '#4ade80');
                es.close();
            } else if (txt.includes('SSH FAIL')) {
                if (statusEl) { statusEl.textContent = '❌ SSH FAIL'; statusEl.style.color = '#f87171'; }
                nbdUpdateRowStatus(label, '❌ SSH FAIL', '#f87171');
                es.close();
            }
        };
        es.onerror = () => es.close();
    }

    function nbdUpdateRowStatus(label, text, color) {
        const rows = document.querySelectorAll('#nbd-vm-tbody tr');
        rows.forEach(row => {
            const lbl = (row.querySelector('.nbd-label') || {}).value || '';
            if (lbl === label) {
                const statusCells = row.querySelectorAll('[id^="nbd-status-"]');
                statusCells.forEach(s => { s.textContent = text; s.style.color = color; });
            }
        });
    }

    async function nbdLaunch() {
        const vms = nbdGetVms();
        if (!vms.length) { alert('Add at least one VM row before launching.'); return; }
        const jh       = nbdGetJumphostParams();
        const flexCreds= nbdGetFlexCreds();
        const btn      = document.getElementById('nbd-launch-btn');
        if (btn) { btn.disabled = true; btn.textContent = '⏳ Launching…'; }

        // Create terminals
        vms.forEach(vm => nbdCreateTerminal(vm.label));

        try {
            const resp = await fetch('/api/vm_migrator/nbd/run', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ...jh, flex_creds: flexCreds, vms })
            });
            const data = await resp.json();
            if (data.error) { alert('Launch error: ' + data.error); return; }

            // Start streaming each VM log
            (data.workers || []).forEach(w => {
                if (w.error) {
                    nbdAppendLog(w.label, '[ERROR] ' + w.error);
                } else {
                    nbdStreamLog(w.label, jh.jumphost_ip, jh.jumphost_user, jh.ssh_key_path);
                }
            });

            // Poll status every 60s
            nbdPollStatus(jh);

        } catch(e) {
            alert('Request failed: ' + e.message);
        } finally {
            if (btn) { btn.disabled = false; btn.textContent = '▶ Launch All VMs'; }
        }
    }

    function nbdPollStatus(jh) {
        const ival = setInterval(async () => {
            try {
                const r = await fetch(`/api/vm_migrator/nbd/status?jumphost_ip=${encodeURIComponent(jh.jumphost_ip)}&jumphost_user=${encodeURIComponent(jh.jumphost_user)}&ssh_key=${encodeURIComponent(jh.ssh_key_path)}`);
                const d = await r.json();
                const resDiv = document.getElementById('nbd-results');
                if (resDiv && d.results && d.results.length) {
                    resDiv.innerHTML = '<b style="color:#94a3b8">Results:</b><br>' +
                        d.results.map(r => {
                            const ok = r.startsWith('SSH_OK');
                            return `<span style="color:${ok?'#4ade80':'#f87171'}">${r}</span>`;
                        }).join('<br>');
                }
                // Stop polling when no workers running and no qemu
                if (!d.workers_running || (d.workers_running.length === 1 && d.workers_running[0] === 'none')) {
                    clearInterval(ival);
                }
            } catch(e) { /* ignore */ }
        }, 60000);
    }

    async function nbdStop() {
        const jh = nbdGetJumphostParams();
        await fetch('/api/vm_migrator/nbd/stop', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(jh)
        });
        alert('Stop signal sent to jumphost.');
    }

    // Show/hide NBD panel on page load
    document.addEventListener('DOMContentLoaded', () => {
        // Restore saved repair method FIRST, then toggle panel + button label
        const saved = localStorage.getItem('mig_offline_repair_method');
        if (saved) {
            const sel = document.getElementById('offline_repair_method');
            if (sel) sel.value = saved;
        }
        toggleNbdPanel();

        // Auto-load last scan from server CSV so table persists across sessions
        (async () => {
            try {
                const cr = await fetch('/api/agent1/results/discovery_csv?t=' + Date.now());
                if (!cr.ok) return;
                const csvText = await cr.text();
                if (!csvText || csvText.trim().length < 10) return;
                Papa.parse(csvText, { header: true, skipEmptyLines: true, complete: function(r) {
                    if (!r.data || r.data.length === 0) return;
                    r.data.forEach(row => { if (!row['Source']) row['Source'] = 'scan'; });
                    if (!r.meta.fields.includes('Source')) r.meta.fields.unshift('Source');
                    flavorState.headers = r.meta.fields;
                    flavorState.rows = r.data;
                    flavorState.filtered = [...r.data];
                    document.getElementById('advFlavorContainer').style.display = 'block';
                    if (window._renderAdvTable) window._renderAdvTable(flavorState, 'flavor-table', 'mapperRowCount', false);
                }});
            } catch(e) { /* silent — no prior scan yet */ }
        })();
    });
    </script>

<!-- ── Add VM to Migrate Modal ─────────────────────────────────────── -->
<div id="addVmModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.7);align-items:center;justify-content:center;">
  <div style="background:#0f172a;border:1px solid rgba(99,102,241,0.4);border-radius:12px;padding:28px 32px;width:480px;max-width:95vw;box-shadow:0 8px 40px rgba(0,0,0,0.6);">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h3 style="color:#a5b4fc;margin:0;font-size:1rem;">+ Add VM to Migrate</h3>
      <button onclick="closeAddVmModal()" style="background:none;border:none;color:#64748b;font-size:1.3rem;cursor:pointer;line-height:1;">✕</button>
    </div>
    <div style="display:flex;flex-direction:column;gap:12px;">
      <div>
        <label style="color:#94a3b8;font-size:.8rem;display:block;margin-bottom:4px;">Server Name *</label>
        <input id="addVm_name" type="text" placeholder="e.g. u24-BackEnd-3" style="width:100%;box-sizing:border-box;background:rgba(255,255,255,0.05);border:1px solid rgba(99,102,241,0.3);border-radius:6px;color:#e2e8f0;padding:8px 10px;font-size:.9rem;">
      </div>
      <div>
        <label style="color:#94a3b8;font-size:.8rem;display:block;margin-bottom:4px;">Public IP *</label>
        <input id="addVm_ip" type="text" placeholder="e.g. 104.130.10.5" style="width:100%;box-sizing:border-box;background:rgba(255,255,255,0.05);border:1px solid rgba(99,102,241,0.3);border-radius:6px;color:#e2e8f0;padding:8px 10px;font-size:.9rem;">
      </div>
      <div>
        <label style="color:#94a3b8;font-size:.8rem;display:block;margin-bottom:4px;">SSH User *</label>
        <input id="addVm_user" type="text" placeholder="e.g. ubuntu / root / almalinux" style="width:100%;box-sizing:border-box;background:rgba(255,255,255,0.05);border:1px solid rgba(99,102,241,0.3);border-radius:6px;color:#e2e8f0;padding:8px 10px;font-size:.9rem;">
      </div>
      <div>
        <label style="color:#94a3b8;font-size:.8rem;display:block;margin-bottom:4px;">Service Type</label>
        <input id="addVm_service" type="text" placeholder="e.g. cloud_server" value="cloud_server" style="width:100%;box-sizing:border-box;background:rgba(255,255,255,0.05);border:1px solid rgba(99,102,241,0.3);border-radius:6px;color:#e2e8f0;padding:8px 10px;font-size:.9rem;">
      </div>
      <div>
        <label style="color:#a78bfa;font-size:.8rem;display:block;margin-bottom:4px;">Target FLEX Flavor <span style="color:#64748b;font-weight:normal;">(from flavormap.csv)</span></label>
        <input id="addVm_flavor" type="text" list="addVm_flavor_list" placeholder="Pick or type a FLEX flavor…" autocomplete="off"
          style="width:100%;box-sizing:border-box;background:rgba(167,139,250,0.05);border:1px solid rgba(167,139,250,0.3);border-radius:6px;color:#a78bfa;padding:8px 10px;font-size:.9rem;font-family:monospace;">
        <datalist id="addVm_flavor_list"></datalist>
      </div>
    </div>
    <div id="addVmError" style="display:none;color:#f87171;font-size:.8rem;margin-top:10px;"></div>
    <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px;">
      <button onclick="closeAddVmModal()" style="background:none;border:1px solid #334155;color:#94a3b8;padding:8px 18px;border-radius:6px;cursor:pointer;">Cancel</button>
      <button onclick="confirmAddVm()" style="background:rgba(34,197,94,0.15);border:1px solid #22c55e;color:#4ade80;padding:8px 18px;border-radius:6px;cursor:pointer;font-weight:600;">Add VM</button>
    </div>
  </div>
</div>

<script>
function openAddVmModal() {
    // Only works when the VM table is loaded
    if (!flavorState.headers.length) {
        // Bootstrap the table with minimal headers if no CSV loaded
        if (!flavorState.headers.length) {
            flavorState.headers = ['service_type', 'name', 'public_ips'];
            flavorState.rows = [];
            flavorState.filtered = [];
            document.getElementById('advFlavorContainer').style.display = 'block';
        }
    }
    ['addVm_name','addVm_ip','addVm_user','addVm_flavor'].forEach(id => {
        const el = document.getElementById(id);
        if (el && id !== 'addVm_user' && id !== 'addVm_service') el.value = '';
    });
    document.getElementById('addVmError').style.display = 'none';
    const modal = document.getElementById('addVmModal');
    modal.style.display = 'flex';
}

function closeAddVmModal() {
    document.getElementById('addVmModal').style.display = 'none';
}

function confirmAddVm() {
    const name    = document.getElementById('addVm_name').value.trim();
    const ip      = document.getElementById('addVm_ip').value.trim();
    const user    = document.getElementById('addVm_user').value.trim();
    const service = document.getElementById('addVm_service').value.trim() || 'cloud_server';
    const flavor  = document.getElementById('addVm_flavor').value.trim();

    const errEl = document.getElementById('addVmError');
    if (!name || !ip || !user) {
        errEl.textContent = '⚠️ Server Name, Public IP and SSH User are required.';
        errEl.style.display = 'block';
        return;
    }
    errEl.style.display = 'none';

    // Ensure table headers include the needed columns
    ['service_type','name','public_ips'].forEach(col => {
        if (!flavorState.headers.includes(col)) flavorState.headers.push(col);
    });

    // Build the new row — insert at top, flag as manually added
    const newRow = { service_type: service, name: name, public_ips: ip, ssh_user: user, _manually_added: true };
    flavorState.rows.unshift(newRow);
    flavorState.filtered = [...flavorState.rows];

    // Persist manual VMs to localStorage so they survive page restarts
    try {
        const manuals = flavorState.rows.filter(r => r._manually_added);
        localStorage.setItem('ospc2flex_manual_vms', JSON.stringify(manuals));
    } catch(e) {}

    document.getElementById('advFlavorContainer').style.display = 'block';

    // Use the exposed global render function
    if (window._renderAdvTable) {
        window._renderAdvTable(flavorState, 'flavor-table', 'mapperRowCount', false);
    }

    // After render, patch flavor cell + checkbox if flavor provided
    if (flavor) {
        const safeName = name.replace(/"/g, '\\"');
        const cb = document.querySelector(`.vm-checkbox[data-source-name="${safeName}"]`);
        if (cb) { cb.dataset.flavor = flavor; cb.title = `Flavor: ${flavor}`; }
        const cell = document.querySelector(`.flavor-cell[data-source-name="${safeName}"]`);
        if (cell) cell.textContent = flavor;
    }

    closeAddVmModal();
}

// Close modal on backdrop click
document.getElementById('addVmModal').addEventListener('click', function(e) {
    if (e.target === this) closeAddVmModal();
});
</script>
