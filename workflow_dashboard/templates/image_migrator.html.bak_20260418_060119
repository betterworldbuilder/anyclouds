        // Stage color map (matches user spec)
        const STAGE_COLORS = {
            '1':'#94a3b8', '2':'#f97316', '2.5':'#64748b',
            '3':'#22d3ee', '4':'#facc15', '4.5':'#c084fc',
            '5':'#4ade80', '5.5':'#64748b', '6':'#60a5fa', '7':'#2dd4bf'
        };
        function getStageColor(txt) {
            const m = txt.match(/STAGE\s+(\d+(?:\.\d+)?)/);
            return m ? (STAGE_COLORS[m[1]] || '#38bdf8') : null;
        }

        function appendVmLog(vmName, text, _type) {
            const panel = getOrCreateVmPanel(vmName);
            if (!panel) { appendLog('[' + vmName + '] ' + text, 'info'); return; }

            const el  = document.createElement('div');
            const ts  = new Date().toLocaleTimeString();
            const esc = s => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            const safe = esc(text);
            const sc  = getStageColor(text);
            const isBorder = /^[\u250c\u2514\u2502\u2501\u2550\u256d\u2570]/.test(text);

            // ── Stage border/box lines ─────────────────────────────────────────
            if (sc && isBorder) {
                el.innerHTML = `<span style="color:${sc};font-weight:bold">${safe}</span>`;
            }
            // ── Inline stage banners (─── STAGE N ──) ─────────────────────────
            else if (sc && (text.includes('STAGE') && (text.includes('─') || text.includes('==') || text.includes('──')))) {
                el.innerHTML = `<span style="color:#475569">[${ts}]</span> <span style="color:${sc};font-weight:bold;letter-spacing:0.5px">${safe}</span>`;
            }
            // ── [OK] / ✅ / ✔ — success ───────────────────────────────────────
            else if (text.includes('[OK]') || text.startsWith('\u2705') || text.startsWith('\u2714') || text.startsWith('\u2713') || text.includes('RESULT: SUCCESS')) {
                el.innerHTML = `<span style="color:#475569">[${ts}]</span> <span style="color:#4ade80;font-weight:bold">${safe}</span>`;
            }
            // ── [PROCESS EXITED] ──────────────────────────────────────────────
            else if (text.includes('[PROCESS EXITED')) {
                const ok = text.includes('CODE 0');
                el.innerHTML = `<span style="color:#475569">[${ts}]</span> <span style="color:${ok?'#4ade80':'#f87171'};font-weight:bold">${safe}</span>`;
            }
            // ── STDERR / RuntimeError / Traceback ─────────────────────────────
            else if (text.startsWith('STDERR:') || text.includes('RuntimeError') || text.includes('Traceback') || text.includes('[FATAL]')) {
                el.innerHTML = `<span style="color:#475569">[${ts}]</span> <span style="color:#fb7185;font-weight:bold">${safe}</span>`;
            }
            // ── ❌ / FAILED / ERROR ───────────────────────────────────────────
            else if (text.includes('[ERROR]') || text.includes('RESULT: FAILED') || text.startsWith('\u274c') || text.startsWith('\u2716')) {
                el.innerHTML = `<span style="color:#475569">[${ts}]</span> <span style="color:#f87171;font-weight:bold">${safe}</span>`;
            }
            // ── [WARN] ────────────────────────────────────────────────────────
            else if (text.includes('[WARN]')) {
                el.innerHTML = `<span style="color:#475569">[${ts}]</span> <span style="color:#fbbf24">${safe}</span>`;
            }
            // ── [RUN] — subtle de-emphasis ────────────────────────────────────
            else if (text.includes('[RUN]')) {
                el.innerHTML = `<span style="color:#334155;font-size:0.88em">${safe}</span>`;
            }
            // ── Progress % ────────────────────────────────────────────────────
            else if (/^\s*\(\d+\.\d+\/100%\)/.test(text)) {
                el.innerHTML = `<span style="color:#334155;font-size:0.8em">${safe}</span>`;
            }
            // ── Separator lines ────────────────────────────────────────────────
            else if (/^[\u2501\u2550\u2501\u25012014\u2500]{3,}/.test(text) || text.startsWith('===')) {
                el.innerHTML = `<span style="color:#1e3a5f">${safe}</span>`;
            }
            // ── Default ────────────────────────────────────────────────────────
            else {
                el.innerHTML = `<span style="color:#475569">[${ts}]</span> <span style="color:#cbd5e1">${safe}</span>`;
            }

            panel.appendChild(el);
            panel.scrollTop = panel.scrollHeight;
        }

        function setVmStatus(vmName, status) {
