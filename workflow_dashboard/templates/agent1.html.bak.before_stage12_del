    function parseCSVToTable(csv) {
        if(!csv) return;
        const rows = csv.trim().split('\n');
        let nodesMap = new Map();
        
        for (let i = 1; i < rows.length; i++) {
            const cols = rows[i].split(',');
            if (cols.length < 9) continue;
            // CSV: step_id, phase, component, source, target, action, status, exit_code, error
            let phase = cols[1].trim();
            let comp = cols[2].trim();
            let source = cols[3].trim();
            let targetIP = cols[4].trim();
            let action = cols[5].trim();
            let status = cols[6].trim().replace(/"/g, ''); // Fix quotes from bash log
            let error = cols[8].trim().replace(/"/g, '');
            
            // For IP, we extract the base IP if target has port or path
            let ipExtracted = targetIP.split(':')[0];
            if(ipExtracted === '-') ipExtracted = source.split(':')[0]; // Fallback to source
            if(ipExtracted === '-') continue; // PRE checks or global steps might not map
            
            let key = comp + "_" + ipExtracted;
            if(!nodesMap.has(key)) {
                nodesMap.set(key, {
                    comp: comp,
                    ip: ipExtracted,
                    deps: 'None defined',
                    depStatus: '',
                    appData: 'None mapped',
                    dataStatus: '',
                    error: ''
                });
            }
            
            let node = nodesMap.get(key);
            if(phase === 'dependency_check' || phase === 'environment_check' || phase === 'dependency') {
                if(action.includes('verify dependencies')) {
                   let d = action.split('verify dependencies on target: ')[1];
                   if(d) node.deps = d;
                }
                node.depStatus = status;
                if(status !== 'PASS' && error) node.error += " " + error;
            }
            if(phase === 'frontend' || phase === 'backend' || phase === 'custom' || phase === 'database') {
                if(action.includes('tar memory stream') || action.includes('logical dump/restore') || action.includes('Data Migration')) {
                    node.appData = `${source} -> ${targetIP}`;
                    node.dataStatus = status;
                    if(status !== 'PASS' && status !== 'SKIP' && error) node.error += " " + error;
                    // Provide explicit SKIP error if guardrail tripped
                    if(status === 'SKIP' && !node.error) node.error = error;
                }
            }
        }
        
        globalStateTable = Array.from(nodesMap.values());
        let html = '';
        globalStateTable.forEach(n => {
            html += `<tr style="border-bottom: 1px solid #334155;">
                <td style="padding: 12px 5px; font-weight: 500;">${n.comp}</td>
                <td style="padding: 12px 5px; font-family: monospace;">${n.ip}</td>
                <td style="padding: 12px 5px; font-size: 0.9rem; color: #cbd5e1; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${n.deps}">${n.deps}</td>
                <td style="padding: 12px 5px;">${generateBadge(n.depStatus)}</td>
                <td style="padding: 12px 5px; font-size: 0.85rem; color: #94a3b8; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${n.appData}">${n.appData.replace(/<.*?>/g, '')}</td>
                <td style="padding: 12px 5px;">${generateBadge(n.dataStatus)}</td>
                <td style="padding: 12px 5px; color: #f87171; font-size: 0.85rem;">${n.error}</td>
            </tr>`;
        });
        
        document.getElementById('results-table-body').innerHTML = html;
    }

