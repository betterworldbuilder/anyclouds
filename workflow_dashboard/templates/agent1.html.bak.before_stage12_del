            // Project / region config
            'project_customer_name', 'ospc_discovery_region', 'flex_deploy_region', 'architecture_mode'
        ];

        function doInit() {
            persistIds.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                // Restore saved value
                const saved = localStorage.getItem('op_conf_' + id);
                if (saved !== null) el.value = saved;
                // Save on every change
                const evts = el.tagName === 'SELECT' ? ['change'] : ['input', 'change'];
                evts.forEach(evt => el.addEventListener(evt, e => {
                    localStorage.setItem('op_conf_' + id, e.target.value);
