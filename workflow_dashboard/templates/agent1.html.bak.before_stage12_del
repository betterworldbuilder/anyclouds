    function autoPlaybook(n) {
        const s = (n.services || []).join(' ').toLowerCase();
        const p = (n.packages || []).join(' ').toLowerCase();
        const r = (n.runtimes || []).join(' ').toLowerCase();
        const ports = n.ports || [];
        if (s.includes('wordpress') || p.includes('wordpress')) return 'WordPress';
        if (s.includes('drupal') || p.includes('drupal')) return 'Drupal';
        if (s.includes('nginx') || s.includes('apache')) return (ports.includes(3306) || ports.includes(5432)) ? 'PHP' : 'Web/Proxy';
        if (ports.includes(5432) || s.includes('postgres')) return 'PostgreSQL';
        if (ports.includes(3306) || s.includes('mysql')) return 'MySQL';
        if (s.includes('node') || r.includes('node')) return 'Node.js';
        if (s.includes('python') || r.includes('python')) return 'Python';
        if (s.includes('java') || r.includes('java')) return 'Java';
        if (s.includes('dotnet') || r.includes('dotnet')) return '.NET';
        if (s.includes('php')) return 'PHP';
        if ((n.os || '').toLowerCase().includes('windows')) return 'Windows IIS';
        return 'Generic';
    }

