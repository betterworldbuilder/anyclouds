            btn.innerHTML = `<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Verified`;
            btn.style.borderColor = "#4ade80";
            btn.style.color = "#4ade80";
            btn.disabled = false;
        } catch(e) {
