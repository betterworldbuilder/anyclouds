    // ═══════ MATCHING TABLE ═══════
    function buildMatchingTable() {
        const matchBody = document.getElementById('ospc-flex-match-body');
        if (!matchBody) return;
        matchBody.innerHTML = '';
        
        // Get OSPC servers from the already-loaded topology
        let ospcServers = [];
        const ospcRows = document.querySelectorAll('#stage1-results-body tr');
        ospcRows.forEach(tr => {
            const cells = tr.querySelectorAll('td');
            if (cells.length >= 2) {
                ospcServers.push({ name: cells[0]?.textContent?.trim() || '', ip: cells[1]?.textContent?.trim() || '' });
            }
        });
        // Also try from the resource tab servers
        if (ospcServers.length === 0) {
            const resTrs = document.querySelectorAll('#res-servers-body tr');
            resTrs.forEach(tr => {
                const cells = tr.querySelectorAll('td');
                if (cells.length >= 3) {
                    ospcServers.push({ name: cells[0]?.textContent?.trim() || '', ip: cells[1]?.textContent?.trim() || '' });
                }
            });
        }
        
        const flexServers = flexDiscoveryData?.servers || [];
        
        // Build flex name -> server map (case insensitive)
        const flexMap = {};
        flexServers.forEach(fs => { flexMap[fs.name.toLowerCase()] = fs; });
        
        let matchCount = 0;
        
        ospcServers.forEach(ospc => {
            const flexMatch = flexMap[ospc.name.toLowerCase()];
            const matched = !!flexMatch;
            if (matched) matchCount++;
            
            const statusHtml = matched 
                ? '<span style="color:#6ee7b7; font-weight:600;">✅ Matched</span>'
                : '<span style="color:#f87171; font-weight:600;">❌ Not Found</span>';
            
            matchBody.insertAdjacentHTML('beforeend', `
                <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
                    <td style="padding:8px 5px; font-size:0.85rem; color:#f9a8d4;">${ospc.name}</td>
                    <td style="padding:8px 5px; font-size:0.85rem; font-family:Fira Code,monospace;">${ospc.ip}</td>
                    <td style="padding:8px 5px; font-size:0.85rem; color:#6ee7b7;">${flexMatch ? flexMatch.name : '—'}</td>
                    <td style="padding:8px 5px; font-size:0.85rem; font-family:Fira Code,monospace;">${flexMatch ? flexMatch.external_ip : '—'}</td>
                    <td style="padding:8px 5px; font-size:0.85rem;">${statusHtml}</td>
                </tr>
            `);
        });
        
        // Show any FLEX servers that don't have OSPC matches
        const ospcNames = new Set(ospcServers.map(s => s.name.toLowerCase()));
        flexServers.forEach(fs => {
            if (!ospcNames.has(fs.name.toLowerCase())) {
                matchBody.insertAdjacentHTML('beforeend', `
                    <tr style="border-bottom:1px solid rgba(255,255,255,0.04); opacity:0.6;">
                        <td style="padding:8px 5px; font-size:0.85rem; color:var(--text-muted);">—</td>
                        <td style="padding:8px 5px; font-size:0.85rem;">—</td>
                        <td style="padding:8px 5px; font-size:0.85rem; color:#6ee7b7;">${fs.name}</td>
                        <td style="padding:8px 5px; font-size:0.85rem; font-family:Fira Code,monospace;">${fs.external_ip}</td>
                        <td style="padding:8px 5px; font-size:0.85rem;"><span style="color:#fbbf24;">⚠️ FLEX Only</span></td>
                    </tr>
                `);
            }
        });
        
        showToast(`🔗 Matching complete: ${matchCount}/${ospcServers.length} OSPC servers matched on FLEX`);
    }

    // ═══════ AUTO-FILL FLEX IPs ═══════
    window.autoFillFlexIPs = function() {
        if (!flexDiscoveryData || !flexDiscoveryData.servers) {
            showToast('⚠️ Run FLEX Discovery first!');
            return;
        }
        
        const flexMap = {};
        flexDiscoveryData.servers.forEach(fs => { flexMap[fs.name.toLowerCase()] = fs; });
        
        let filled = 0;
        
        // Find all FLEX target node groups in Stage 1
        const nodeGroups = document.querySelectorAll('#flex-fields-stage1 .custom-node-group-s1, #flex-custom-fields-stage1 .custom-node-group-s1');
        nodeGroups.forEach(group => {
            const nodeName = group.getAttribute('data-name') || '';
            const ipInput = group.querySelector('input[name="flex_custom_ip[]"]');
            if (!ipInput) return;
            
            // Try exact match first, then partial
            let match = flexMap[nodeName.toLowerCase()];
            if (!match) {
                // Try partial match (e.g., "frontend_01" matches "frontend-01")
                const normalized = nodeName.toLowerCase().replace(/[_-]/g, '');
                for (const [key, val] of Object.entries(flexMap)) {
                    if (key.replace(/[_-]/g, '') === normalized) {
                        match = val;
                        break;
                    }
                }
            }
            
            if (match && match.external_ip && match.external_ip !== '—') {
                ipInput.value = match.external_ip;
                ipInput.style.borderColor = '#10b981';
                ipInput.style.background = 'rgba(16,185,129,0.1)';
                filled++;
            }
        });
        
        // Also try filling Stage 2 fields
        const s2Groups = document.querySelectorAll('.custom-node-group-s2');
        s2Groups.forEach(group => {
            const nodeName = group.getAttribute('data-name') || '';
            const ipInput = group.querySelector('input[name="flex_custom_ip[]"]');
            if (!ipInput || (ipInput.value && ipInput.value !== '' && ipInput.value !== 'Enter target 10.60.x.x')) return;
            
            let match = flexMap[nodeName.toLowerCase()];
            if (!match) {
                const normalized = nodeName.toLowerCase().replace(/[_-]/g, '');
                for (const [key, val] of Object.entries(flexMap)) {
                    if (key.replace(/[_-]/g, '') === normalized) { match = val; break; }
                }
            }
            
            if (match && match.external_ip && match.external_ip !== '—') {
                ipInput.value = match.external_ip;
                ipInput.style.borderColor = '#10b981';
                ipInput.style.background = 'rgba(16,185,129,0.1)';
                filled++;
            }
        });
        
        showToast(`⚡ Auto-filled ${filled} FLEX target IPs from discovery`);
    };

    // ═══════ OpenRC FILE PARSER ═══════
    function parseOpenRC(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            const lines = e.target.result.split('\n');
            const map = {};
            lines.forEach(line => {
                const m = line.match(/^export\s+(\w+)=["']?(.+?)["']?\s*$/);
                if (m) map[m[1]] = m[2];
            });
            if (map.OS_AUTH_URL) document.getElementById('flex_auth_url').value = map.OS_AUTH_URL;
            if (map.OS_USERNAME) document.getElementById('flex_cloud_user').value = map.OS_USERNAME;
            if (map.OS_PASSWORD) document.getElementById('flex_cloud_key').value = map.OS_PASSWORD;
            if (map.OS_PROJECT_ID) document.getElementById('flex_cloud_account').value = map.OS_PROJECT_ID;
            if (map.OS_USER_DOMAIN_NAME) document.getElementById('flex_cloud_domain').value = map.OS_USER_DOMAIN_NAME;
            else if (map.OS_PROJECT_DOMAIN_NAME) document.getElementById('flex_cloud_domain').value = map.OS_PROJECT_DOMAIN_NAME;
            if (map.OS_REGION_NAME) {
                const sel = document.getElementById('flex-discovery-region');
                for (let opt of sel.options) { if (opt.value === map.OS_REGION_NAME) { sel.value = map.OS_REGION_NAME; break; } }
            }
            showToast(`✅ OpenRC imported: ${Object.keys(map).length} variables loaded from ${file.name}`);
        };
        reader.readAsText(file);
    }

</script>
