            });

            // Re-trigger architecture dropdown so topology DOM updates
            setTimeout(() => {
                const modeEl = document.getElementById('architecture_mode');
                if (!modeEl) return;
                if (!modeEl.value.endsWith('.csv')) {
                    if (typeof generateDOM === 'function') generateDOM(modeEl.value);
                } else {
                    modeEl.dispatchEvent(new Event('change'));
                }
            }, 500);
        }

        // Script is at bottom of body — DOM is already ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', doInit);
        } else {
            doInit();
        }
    })();


