<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apps Migration Manual semi Auto</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #0f111a;
            --bg-surface: rgba(25, 28, 41, 0.6);
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.4);
            --secondary: #ec4899;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: rgba(255, 255, 255, 0.08);
            --input-bg: rgba(15, 17, 26, 0.5);
            --success: #10b981;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-base);
            color: var(--text-main);
            background-image: radial-gradient(circle at 15% 50%, rgba(99, 102, 241, 0.15), transparent 25%),
                              radial-gradient(circle at 85% 30%, rgba(236, 72, 153, 0.15), transparent 25%);
            background-attachment: fixed;
            display: flex; justify-content: center;
            padding: 40px 20px; line-height: 1.6;
        }

        .container { max-width: 1200px; width: 100%; display: flex; flex-direction: column; gap: 30px; }

        header { text-align: center; margin-bottom: 20px; }
        header h1 {
            font-size: 2.5rem; font-weight: 700;
            background: linear-gradient(135deg, #a5b4fc, #fbcfe8);
            -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
            margin-bottom: 15px; letter-spacing: -0.5px;
        }
        header p { color: var(--text-muted); font-size: 1.1rem; }

        .panel {
            background: var(--bg-surface); border: 1px solid var(--border);
            border-radius: 20px; padding: 30px;
            backdrop-filter: blur(16px);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .section-title {
            font-size: 1.25rem; font-weight: 600; margin-bottom: 20px;
            display: flex; align-items: center; gap: 10px; color: #e2e8f0; justify-content: space-between;
        }
        .section-title::before {
            content: ''; display: block; width: 8px; height: 24px;
            background: linear-gradient(to bottom, var(--primary), var(--secondary)); border-radius: 4px;
            position: absolute; left: 30px;
        }
        .section-title-wrapper { display: flex; align-items: center; gap: 10px; padding-left: 18px;}

        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; }

        .form-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 15px; }
        
        .node-group { margin-bottom: 25px; padding: 15px; background: rgba(0,0,0,0.2); border-radius: 12px; border: 1px solid var(--border); }
        .node-group h3 { font-size: 1.05rem; color: #a5b4fc; margin-bottom: 15px; border-bottom: 1px solid var(--border); padding-bottom: 8px; display: flex; justify-content: space-between; align-items: center;}

        label { font-size: 0.9rem; font-weight: 500; color: var(--text-muted); }

        select, input[type="text"], input[type="password"], input[type="number"], textarea {
            background: var(--input-bg); border: 1px solid var(--border);
            border-radius: 10px; padding: 12px 16px; color: var(--text-main);
            font-family: 'Fira Code', monospace; font-size: 0.9rem;
            outline: none; width: 100%; transition: all 0.3s;
        }
        select { font-family: 'Outfit', sans-serif; cursor: pointer; }
        textarea { resize: vertical; min-height: 100px; }

        input:focus, textarea:focus, select:focus {
            border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-glow); background: rgba(15, 17, 26, 0.8);
        }

        .btn-wrapper { display: flex; justify-content: center; margin-top: 20px; gap: 15px; }
        button {
            background: linear-gradient(135deg, var(--primary), #818cf8); color: white;
            border: none; padding: 14px 32px; border-radius: 12px;
            font-size: 1.1rem; font-weight: 600; font-family: 'Outfit', sans-serif;
            cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 15px var(--primary-glow);
            display: flex; align-items: center; gap: 10px;
        }
        button:hover { transform: translateY(-2px); box-shadow: 0 8px 25px var(--primary-glow); }
        
        button.secondary { background: transparent; border: 1px solid var(--border); box-shadow: none; }
        button.secondary:hover { border-color: var(--text-main); background: rgba(255,255,255,0.05); }

        .output-panel { display: none; animation: slideUp 0.5s forwards; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        pre { background: #0d0f18; padding: 24px; border-radius: 12px; overflow-x: auto; max-height: 450px; overflow-y: auto; border: 1px solid var(--border); scroll-behavior: smooth;}
        code { font-family: 'Fira Code', monospace; font-size: 0.9rem; color: #c9d1d9; line-height: 1.5; white-space: pre-wrap;}
        .bash-comment { color: #8b949e; } .bash-var { color: #79c0ff; } .bash-string { color: #a5d6ff; } .bash-keyword { color: #ff7b72; }

        .toast {
            position: fixed; bottom: 30px; right: 30px; background: var(--success); color: white;
            padding: 12px 24px; border-radius: 8px; font-weight: 500;
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4); transform: translateY(100px); opacity: 0; transition: all 0.4s;
        }
        .toast.show { transform: translateY(0); opacity: 1; }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Apps Migration Manual semi Auto</h1>
        <p>Advanced Migration Builder: Dynamically scale and migrate clusters natively with Rsync, Prechecks & Auto-Logging</p>
    </header>


    <form id="migration-form">
        <div class="panel" style="margin-bottom: 30px;">
            <div class="form-grid" style="margin-bottom: 30px; padding-bottom: 30px; border-bottom: 1px solid var(--border)">
                <div>
                    <h2 class="section-title"><div class="section-title-wrapper">OSPC Cloud Credentials</div></h2>
                    <div class="form-group"><label>Username</label><input type="text" id="ospc_cloud_user" placeholder="e.g. admin"></div>
                    <div class="form-group"><label>API Key / Password</label><input type="password" id="ospc_cloud_key" placeholder="Enter API Key"></div>
                    <div class="form-group"><label>Account / Project ID</label><input type="text" id="ospc_cloud_account" placeholder="e.g. 123456789"></div>
                </div>
                <div>
                    <h2 class="section-title"><div class="section-title-wrapper">FLEX Cloud Credentials (Keystone v3)</div></h2>
                    <div class="form-group"><label>Auth URL</label><input type="text" id="flex_auth_url" placeholder="e.g. https://keystone.flex.rackspacecloud.com/v3" value="https://keystone.api.dfw3.rackspacecloud.com/v3/"></div>
                    <div class="form-group"><label>Username</label><input type="text" id="flex_cloud_user" placeholder="e.g. your.username" value=""></div>
                    <div class="form-group"><label>Password</label><input type="password" id="flex_cloud_key" placeholder="Enter Password"></div>
                    <div class="form-group"><label>Project ID</label><input type="text" id="flex_cloud_account" placeholder="e.g. 20ffb2987a3b..." value=""></div>
                    <div class="form-group"><label>Domain</label><input type="text" id="flex_cloud_domain" placeholder="e.g. default" value="rackspace_cloud_domain"></div>
                    <div style="margin-top: 8px;">
                        <input type="file" id="flex-openrc-upload" accept=".sh,.rc,.env" style="display:none;" onchange="parseOpenRC(event)">
                        <button type="button" class="secondary" style="padding: 6px 14px; font-size: 0.82rem; border-color: #6ee7b7; color: #6ee7b7;" onclick="document.getElementById('flex-openrc-upload').click()">📂 Import OpenRC File</button>
                    </div>
                </div>
            </div>

            <div class="form-grid" style="margin-bottom: 30px; padding-bottom: 30px; border-bottom: 1px solid var(--border)">
                <div>
                    <h2 class="section-title"><div class="section-title-wrapper">OSPC Server & DB Credentials</div></h2>
                    <div class="form-group"><label>SSH User</label><input type="text" id="ospc_ssh_user" value="ubuntu" required></div>
                    
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                            <label>Use local SSH key path or paste Private Key</label>
                            <div style="display: flex; gap: 6px;">
                                <input type="file" id="ospc_key_upload" accept=".pem,.key,.txt" style="display:none;" onchange="readKeyFile(event, 'ospc_ssh_key')">
                                <label for="ospc_key_upload" class="secondary" style="cursor:pointer; font-size:0.75rem; padding: 3px 8px; border-radius:6px; border:1px solid var(--border); background: rgba(255,255,255,0.05); margin-bottom: 4px;">Upload .pem</label>
                                <button type="button" onclick="savePemKey('ospc_ssh_key', 'ospc')" class="secondary" style="font-size:0.75rem; padding: 3px 8px; border-radius:6px; border:1px solid #10b981; background: rgba(16,185,129,0.1); color: #6ee7b7; cursor:pointer; margin-bottom: 4px;">💾 Save .pem</button>
                            </div>
                        </div>
                        <textarea id="ospc_ssh_key" placeholder="Paste -----BEGIN... or $HOME/.ssh/id_rsa">$HOME/.ssh/id_rsa</textarea>
                    </div>

                    <div class="form-group"><label>Database Name</label><input type="text" id="ospc_db_name" value="pocdb" required></div>
                    <div class="form-group"><label>Database Admin User</label><input type="text" id="ospc_db_admin" value="postgres" required></div>
                    <div class="form-group"><label>Database Password</label><input type="password" id="ospc_db_pass" placeholder="(Optional) DB Password"></div>
                </div>
                <div>
                    <h2 class="section-title"><div class="section-title-wrapper">FLEX Server & DB Credentials</div></h2>
                    <div class="form-group"><label>SSH User</label><input type="text" id="flex_ssh_user" value="ubuntu" required></div>
                    
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: flex-end;">
                            <label>Use local SSH key path or paste Private Key</label>
                            <div style="display: flex; gap: 6px;">
                                <input type="file" id="flex_key_upload" accept=".pem,.key,.txt" style="display:none;" onchange="readKeyFile(event, 'flex_ssh_key')">
                                <label for="flex_key_upload" class="secondary" style="cursor:pointer; font-size:0.75rem; padding: 3px 8px; border-radius:6px; border:1px solid var(--border); background: rgba(255,255,255,0.05); margin-bottom: 4px;">Upload .pem</label>
                                <button type="button" onclick="savePemKey('flex_ssh_key', 'flex')" class="secondary" style="font-size:0.75rem; padding: 3px 8px; border-radius:6px; border:1px solid #10b981; background: rgba(16,185,129,0.1); color: #6ee7b7; cursor:pointer; margin-bottom: 4px;">💾 Save .pem</button>
                            </div>
                        </div>
                        <textarea id="flex_ssh_key" placeholder="Paste -----BEGIN... or $HOME/.ssh/id_rsa">$HOME/.ssh/id_rsa</textarea>
                    </div>

                    <div class="form-group"><label>Database Name</label><input type="text" id="flex_db_name" value="pocdb" required></div>
                    <div class="form-group"><label>Database Admin User</label><input type="text" id="flex_db_admin" value="postgres" required></div>
                    <div class="form-group"><label>Database Password</label><input type="password" id="flex_db_pass" placeholder="(Optional) DB Password"></div>
                </div>
            </div>
        </div>

    <!-- STAGE 0 DISCOVERY PANEL -->
    <div class="panel" style="border-color: #ec4899; position: relative;">
        <h2 class="section-title"><div class="section-title-wrapper">Stage 1: OSPC Environment Discovery</div></h2>
        <p style="color: var(--text-muted); margin-bottom: 20px;">Automatically scan the OSPC host and determine the topology of applications, databases, and caches.</p>
        
        <div style="display: flex; gap: 15px; margin-bottom: 5px; align-items: center;">
            <select id="ospc_discovery_region" style="width: auto; padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2); color: white;">
                <option value="ALL">ALL Regions</option>
                <option value="IAD">IAD (Virginia)</option>
                <option value="DFW">DFW (Dallas)</option>
                <option value="DFW3">DFW3 (Dallas FLEX)</option>
                <option value="ORD">ORD (Chicago)</option>
                <option value="SYD">SYD (Sydney)</option>
                <option value="HKG">HKG (Hong Kong)</option>
                <option value="LON">LON (London)</option>
            </select>
            <button type="button" id="run-discovery-btn" style="background: linear-gradient(135deg, var(--secondary), #f472b6);">🔍 Start OSPC Infra Discovery</button>
            <input type="file" id="inventory-upload" accept=".csv" style="display: none;">
            <button type="button" id="import-offline-csv-btn" class="secondary" style="border-color: #fbcfe8; color: #fbcfe8;">📂 Upload Offline Inventory (CSV)</button>
            <a href="/sample_ecommerce_inventory.csv" target="_blank" class="secondary" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; border-color: rgba(255,255,255,0.2); color: #fff; padding: 0 15px; border-radius: 8px;">📄 Download Template</a>
            <button type="button" id="import-topology-btn" class="secondary" style="display: none; border-color: var(--success); color: var(--success);">📥 Import Discovered Topology to Stage 2</button>
        </div>
        
        <details style="margin-bottom: 20px; color: var(--text-muted); font-size: 0.85rem; background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid var(--border);">
            <summary style="cursor: pointer; color: #a5b4fc;">ℹ️ Required CSV Format Details</summary>
            <div style="margin-top: 10px;">
                Your .csv file must contain at minimum: <strong style="color:white">Name</strong>, <strong style="color:white">IP</strong>, <strong style="color:white">Role</strong><br><br>
                Optional explicitly mapped columns for Stage 2 requirements checks: <strong style="color:white">Packages</strong>, <strong style="color:white">Runtime</strong>, <strong style="color:white">Env</strong>, <strong style="color:white">Services</strong> (comma separated inside quotes), and <strong style="color:white">Customer</strong>.
            </div>
        </details>
        
        <div id="discovery-logs-container" style="display: none; margin-top: 15px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                <span style="font-size: 0.9rem; font-weight: 500; color: #a5b4fc;">Discovery Live Console <span id="discovery-spinner">⚙️</span></span>
            </div>
            <pre style="max-height: 250px;"><code id="discovery-logs" style="color: #a5d6ff;">Initializing...</code></pre>
        </div>
        
        <div id="stage1-results-container" style="display: none; margin-top: 25px; border-top: 1px solid var(--border); padding-top: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h3 style="color: #fbcfe8; font-size: 1.1rem;">Discovered OSPC Resources</h3>
                <a href="/api/agent1/results/discovery_csv" target="_blank" class="secondary" style="padding: 6px 14px; text-decoration: none; color: white; display: inline-flex; border: 1px solid var(--border); border-radius: 8px; font-size: 0.85rem; background: rgba(255,255,255,0.05); align-items: center; gap: 6px;">💾 Download CSV</a>
            </div>

            <!-- Resource Tabs -->
            <div id="res-tabs" style="display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 16px; flex-wrap: wrap;">
                <span class="res-tab active" data-restab="tab-servers" style="padding: 8px 16px; font-size: 0.85rem; font-weight: 500; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.2s; color: var(--text-muted);">🖥️ Servers</span>
                <span class="res-tab" data-restab="tab-stacks" style="padding: 8px 16px; font-size: 0.85rem; font-weight: 500; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.2s; color: var(--text-muted);">📦 Stacks</span>
                <span class="res-tab" data-restab="tab-networking" style="padding: 8px 16px; font-size: 0.85rem; font-weight: 500; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.2s; color: var(--text-muted);">🌐 Networking</span>
                <span class="res-tab" data-restab="tab-storage" style="padding: 8px 16px; font-size: 0.85rem; font-weight: 500; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.2s; color: var(--text-muted);">💾 Storage</span>
                <span class="res-tab" data-restab="tab-databases" style="padding: 8px 16px; font-size: 0.85rem; font-weight: 500; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.2s; color: var(--text-muted);">🗄️ Databases</span>
                <span class="res-tab" data-restab="tab-backups" style="padding: 8px 16px; font-size: 0.85rem; font-weight: 500; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.2s; color: var(--text-muted);">📋 Backups</span>
            </div>

            <!-- TAB: Servers (existing) -->
            <div class="res-tab-content" id="tab-servers" style="overflow-x: auto;">
                <table class="grid-table" style="width: 100%; text-align: left; border-collapse: collapse;">
                    <thead><tr style="border-bottom: 2px solid var(--border);">
                        <th style="padding: 10px 5px; color: var(--text-muted);">Name</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">IP Address</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">OS</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Role</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Detected Services</th>
                    </tr></thead>
                    <tbody id="stage1-results-body"></tbody>
                </table>
            </div>

            <!-- TAB: Stacks -->
            <div class="res-tab-content" id="tab-stacks" style="display: none; overflow-x: auto;">
                <table class="grid-table" style="width: 100%; text-align: left; border-collapse: collapse;">
                    <thead><tr style="border-bottom: 2px solid var(--border);">
                        <th style="padding: 10px 5px; color: var(--text-muted);">Stack Name</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Type</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Status</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Created</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Resources</th>
                    </tr></thead>
                    <tbody id="res-stacks-body"></tbody>
                </table>
            </div>

            <!-- TAB: Networking -->
            <div class="res-tab-content" id="tab-networking" style="display: none; overflow-x: auto;">
                <h4 style="color: #a5b4fc; margin-bottom: 10px; font-size: 0.95rem;">Load Balancers</h4>
                <table class="grid-table" style="width: 100%; text-align: left; border-collapse: collapse; margin-bottom: 20px;">
                    <thead><tr style="border-bottom: 2px solid var(--border);">
                        <th style="padding: 10px 5px; color: var(--text-muted);">Name</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">VIP</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Protocol</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Port</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Members</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Status</th>
                    </tr></thead>
                    <tbody id="res-lb-body"></tbody>
                </table>
                <h4 style="color: #a5b4fc; margin-bottom: 10px; font-size: 0.95rem;">Networks</h4>
                <table class="grid-table" style="width: 100%; text-align: left; border-collapse: collapse; margin-bottom: 20px;">
                    <thead><tr style="border-bottom: 2px solid var(--border);">
                        <th style="padding: 10px 5px; color: var(--text-muted);">Name</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">CIDR</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Type</th>
                    </tr></thead>
                    <tbody id="res-nets-body"></tbody>
                </table>
                <h4 style="color: #a5b4fc; margin-bottom: 10px; font-size: 0.95rem;">Cloud DNS</h4>
                <table class="grid-table" style="width: 100%; text-align: left; border-collapse: collapse; margin-bottom: 20px;">
                    <thead><tr style="border-bottom: 2px solid var(--border);">
                        <th style="padding: 10px 5px; color: var(--text-muted);">Domain</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Records</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Updated</th>
                    </tr></thead>
                    <tbody id="res-dns-body"></tbody>
                </table>
                <h4 style="color: #a5b4fc; margin-bottom: 10px; font-size: 0.95rem;">Security Groups</h4>
                <div id="res-sg-container">
                    <p style="padding:15px; color:var(--text-muted); text-align:center;">No security groups found.</p>
                </div>
            </div>

            <!-- TAB: Storage -->
            <div class="res-tab-content" id="tab-storage" style="display: none; overflow-x: auto;">
                <table class="grid-table" style="width: 100%; text-align: left; border-collapse: collapse;">
                    <thead><tr style="border-bottom: 2px solid var(--border);">
                        <th style="padding: 10px 5px; color: var(--text-muted);">Volume Name</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Size (GB)</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Type</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Attached To</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Status</th>
                    </tr></thead>
                    <tbody id="res-storage-body"></tbody>
                </table>
            </div>

            <!-- TAB: Databases -->
            <div class="res-tab-content" id="tab-databases" style="display: none; overflow-x: auto;">
                <table class="grid-table" style="width: 100%; text-align: left; border-collapse: collapse;">
                    <thead><tr style="border-bottom: 2px solid var(--border);">
                        <th style="padding: 10px 5px; color: var(--text-muted);">Name</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Engine</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">RAM</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Disk</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Replicas</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Status</th>
                    </tr></thead>
                    <tbody id="res-db-body"></tbody>
                </table>
            </div>

            <!-- TAB: Backups -->
            <div class="res-tab-content" id="tab-backups" style="display: none; overflow-x: auto;">
                <table class="grid-table" style="width: 100%; text-align: left; border-collapse: collapse;">
                    <thead><tr style="border-bottom: 2px solid var(--border);">
                        <th style="padding: 10px 5px; color: var(--text-muted);">Backup Name</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Parent Instance</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Region</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Engine</th>
                        <th style="padding: 10px 5px; color: var(--text-muted);">Created</th>
                    </tr></thead>
                    <tbody id="res-backups-body"></tbody>
