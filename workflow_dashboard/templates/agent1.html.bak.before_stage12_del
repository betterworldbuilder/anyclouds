                        <div id="ab-opt1-wrapper" style="display: none; animation: slideUp 0.3s forwards; padding-left: 20px; border-left: 2px solid #10b981; margin-bottom: 20px;">
                            <div class="form-group" style="margin-bottom: 12px;"><label>OSPC Load Balancer Admin IP</label><input type="text" id="ab_lb_ip" placeholder="e.g. 10.50.1.100"></div>
                            <div class="form-group"><label>Initial FLEX Traffic Weight (%)</label><input type="number" id="ab_flex_weight" value="10" min="1" max="100"></div>
