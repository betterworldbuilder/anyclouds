<div class="toast" id="toast">Copied to clipboard!</div>

<script>
    const topologies = {
        monolith: { fe: 2, be: 1, db: 1, lb: 1, cache: 1, worker: 0, search: 0 },
        frontend_api: { fe: 2, be: 3, db: 2, lb: 1, cache: 1, worker: 1, search: 0 },
        ecommerce_medium: { fe: 4, be: 6, db: 3, lb: 2, cache: 1, worker: 4, search: 2 },
        ecommerce_large: { fe: 8, be: 12, db: 4, lb: 3, cache: 3, worker: 8, search: 4 }
    };

    const compLabels = {
        lb: "Load Balancers", fe: "Frontends", be: "Backends",
        db: "Databases (Pri/Rep)", cache: "Redis Caches", worker: "Workers", search: "Search Nodes"
    };

    const pathDefaults = {
        fe: '/var/www/poc', be: '/opt/poc-api', lb: '/etc/nginx',
        cache: '/var/lib/redis', worker: '/opt/poc-worker', search: '/var/lib/elasticsearch'
    };
    
    const serviceDefaults = {
        fe: 'nginx', be: 'poc-api', lb: 'nginx',
        cache: 'redis-server', worker: 'poc-worker', search: 'elasticsearch', db: 'postgresql'
    };

    function readKeyFile(event, targetId) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
            document.getElementById(targetId).value = e.target.result;
        };
        reader.readAsText(file);
    }

    function readKeyFileToInput(event, targetElement) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
            // Encode the key content specifically for bash template safety
            targetElement.value = e.target.result.replace(/\r\n/g, '\n').replace(/\n/g, '\\n');
        };
        reader.readAsText(file);
    }

    async function savePemKey(textareaId, prefix) {
        const keyContent = document.getElementById(textareaId).value.trim();
        if (!keyContent || keyContent === '$HOME/.ssh/id_rsa') {
            alert('Please paste your SSH private key into the field first.');
            return;
        }
        if (!keyContent.includes('PRIVATE KEY')) {
            if (!confirm('This does not look like a PEM private key. Save anyway?')) return;
        }
        const btn = event.target;
        const origText = btn.textContent;
        btn.textContent = '⏳ Saving...';
        btn.disabled = true;
        try {
            const resp = await fetch('/api/agent1/save-pem', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ key: keyContent, prefix: prefix })
            });
            const result = await resp.json();
            if (result.status === 'ok') {
                btn.textContent = '✅ Saved!';
                btn.style.borderColor = '#10b981';
                // Update the textarea to show the saved path
                document.getElementById(textareaId).value = result.path;
                setTimeout(() => { btn.textContent = origText; btn.disabled = false; }, 3000);
            } else {
                btn.textContent = '❌ Failed';
                alert('Save failed: ' + (result.error || 'Unknown error'));
                setTimeout(() => { btn.textContent = origText; btn.disabled = false; }, 2000);
            }
        } catch(e) {
            btn.textContent = '❌ Error';
            alert('Network error: ' + e.message);
            setTimeout(() => { btn.textContent = origText; btn.disabled = false; }, 2000);
        }
    }

    function generateDOM(mode) {
        const spec = topologies[mode];
        const oContainer = document.getElementById('ospc-fields');
        const fContainer = document.getElementById('flex-fields');
        const oContainerS1 = document.getElementById('ospc-fields-stage1');
        const fContainerS1 = document.getElementById('flex-fields-stage1');
        if(oContainer) oContainer.innerHTML = ''; 
        if(fContainer) fContainer.innerHTML = '';
        if(oContainerS1) oContainerS1.innerHTML = ''; 
        if(fContainerS1) fContainerS1.innerHTML = '';

        let ospcIpBase = 10;
        let flexIpBase = 10;

        for (const [key, count] of Object.entries(spec)) {
            if (count === 0) continue;
            
            let oHtml = `<div class="node-group"><h3>${compLabels[key]}</h3>`;
            let fHtml = `<div class="node-group"><h3>${compLabels[key]}</h3>`;

            for (let i = 0; i < count; i++) {
                oHtml += `
                    <div class="form-group" style="margin-bottom: 20px; border-bottom: 1px dashed var(--border); padding-bottom: 15px;">
                        <label>${key.toUpperCase()} Node ${i+1}</label>
                        <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                            <input type="text" name="ospc_${key}[]" value="10.50.${ospcIpBase}.${10+i}" style="flex: 1;" placeholder="OSPC IP">
                            <input type="text" name="ospc_port_${key}[]" value="22" style="width: 70px;" title="SSH Port" placeholder="Port">
                            <input type="text" name="ospc_user_${key}[]" style="width: 85px;" title="SSH Admin Name" placeholder="Admin (opt)">
                            <input type="text" name="ospc_cred_${key}[]" style="width: 100px;" title="SSH Key Path Override" placeholder="Key (opt)">
                            <input type="file" accept=".pem,.key,.txt" style="display:none;" onchange="readKeyFileToInput(event, this.previousElementSibling)">
                            <label style="cursor:pointer; display:flex; align-items:center; margin-left:-5px; padding: 4px; background: rgba(255,255,255,0.05); border-radius: 4px; border: 1px solid var(--border);" onclick="this.previousElementSibling.click()" title="Upload .pem file directly">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                            </label>
                        </div>`;
                        
                if (key !== 'db') {
                    oHtml += `<div style="display: flex; gap: 10px; margin-bottom: 8px;">
                        <input type="text" name="ospc_${key}_path[]" value="${pathDefaults[key]}" style="flex: 1;" title="Source Sync Path" placeholder="/opt/path">
                        <input type="text" name="ospc_${key}_service[]" value="${serviceDefaults[key]}" style="width: 140px;" title="Systemctl Service Name" placeholder="Service">
                    </div>`;
                } else {
                    oHtml += `<div style="display: flex; gap: 10px;">
                        <input type="text" name="ospc_${key}_type[]" value="${serviceDefaults[key]}" style="width: 150px;" title="DB Type">
                        <input type="text" name="ospc_${key}_service[]" value="${serviceDefaults[key]}" style="flex: 1;" title="Systemctl Service Name" placeholder="Service">
                    </div>`;
                }
                oHtml += `</div>`;

                fHtml += `
                    <div class="form-group" style="margin-bottom: 20px; border-bottom: 1px dashed var(--border); padding-bottom: 15px;">
                        <label>${key.toUpperCase()} Node ${i+1}</label>
                        <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                            <input type="text" name="flex_${key}[]" value="10.60.${flexIpBase}.${10+i}" style="flex: 1;" placeholder="FLEX IP">
                            <input type="text" name="flex_port_${key}[]" value="22" style="width: 70px;" title="SSH Port" placeholder="Port">
                            <input type="text" name="flex_user_${key}[]" style="width: 85px;" title="SSH Admin Name" placeholder="Admin (opt)">
                            <input type="text" name="flex_cred_${key}[]" style="width: 100px;" title="SSH Key Path Override" placeholder="Key (opt)">
                            <input type="file" accept=".pem,.key,.txt" style="display:none;" onchange="readKeyFileToInput(event, this.previousElementSibling)">
                            <label style="cursor:pointer; display:flex; align-items:center; margin-left:-5px; padding: 4px; background: rgba(255,255,255,0.05); border-radius: 4px; border: 1px solid var(--border);" onclick="this.previousElementSibling.click()" title="Upload .pem file directly">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                            </label>
                            <a href="javascript:void(0)" onclick="var ip=this.previousElementSibling.previousElementSibling.value; if(ip) window.open('http://'+ip, '_blank');" class="secondary" style="padding: 10px; border-radius: 8px; color: var(--text-main); fill: currentColor; cursor:pointer;" title="Test UI">
                                <svg width="20" height="20" viewBox="0 0 24 24"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
                        </div>`;
                if (key !== 'db') {
                    fHtml += `<div style="display: flex; gap: 10px; margin-bottom: 8px;">
                        <input type="text" name="flex_${key}_path[]" value="${pathDefaults[key]}" style="flex: 1;" title="Target Sync Path" placeholder="/opt/path">
                        <input type="text" name="flex_${key}_service[]" value="${serviceDefaults[key]}" style="width: 140px;" title="Systemctl Service Name" placeholder="Service">
                    </div>`;
                } else {
                    fHtml += `<div style="display: flex; gap: 10px;">
                        <input type="text" name="flex_${key}_type[]" value="${serviceDefaults[key]}" style="width: 150px;" title="DB Type">
                        <input type="text" name="flex_${key}_service[]" value="${serviceDefaults[key]}" style="flex: 1;" title="Systemctl Service Name" placeholder="Service">
                    </div>`;
                }
                fHtml += `</div>`;
            }
            oHtml += `</div>`;
            fHtml += `</div>`;
            let fHtmlS1 = fHtml.replace(/<div style="display: flex; gap: 10px; margin-bottom: 8px;">[\s\S]*?<\/div>/, '');
            fHtmlS1 = fHtmlS1.replace(/<div style="display: flex; gap: 10px;">\s*<input type="text" name="flex_\$\{key\}_type.*[\s\S]*?<\/div>/, '');
            
            if(oContainer) oContainer.innerHTML += oHtml;
            if(fContainer) fContainer.innerHTML += fHtml;
            if(fContainerS1) fContainerS1.innerHTML += fHtmlS1;

            ospcIpBase++; flexIpBase++;
        }
    }

    document.getElementById('architecture_mode').addEventListener('change', async (e) => {
        const val = e.target.value;
        if (val.endsWith('.csv')) {
            try {
                await fetch('/api/agent1/inventory/load', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({file: val})
                });
                document.getElementById('import-topology-btn').click();
            } catch(err) { console.error('Failed to load topology', err); }
        } else {
            generateDOM(val);
        }
    });

    async function loadInventoryDropdown() {
        try {
            let resp = await fetch('/api/agent1/inventory/files');
            let files = await resp.json();
            let sel = document.getElementById('architecture_mode');
            
            // Generate <optgroup> for specific file mappings vs default generic architecture structures
            let optGroup = document.createElement('optgroup');
            optGroup.label = "Discovered & Uploaded Infrastructures";
            
            files.forEach(f => {
                let opt = document.createElement('option');
                opt.value = f.name;
                opt.textContent = `💾 ${f.name} (${f.time})`;
                optGroup.appendChild(opt);
            });
            
            if(files.length > 0) {
                sel.insertBefore(optGroup, sel.firstChild);
            }
        } catch(e) { console.error("Failed to load inventory files", e); }
    }

    loadInventoryDropdown().then(() => {
        // If localStorage has a cached value, don't clobber it yet. localStorage will run later!
        // We will default to calling standard load in DOMContentLoaded loop
    });

    // Discovery Logic
    document.getElementById('run-discovery-btn').addEventListener('click', async () => {
        const logsEle = document.getElementById('discovery-logs');
        document.getElementById('discovery-logs-container').style.display = 'block';
        document.getElementById('import-topology-btn').style.display = 'none';
        document.getElementById('discovery-spinner').style.display = 'inline-block';
        logsEle.textContent = "Connecting to Engine...\n";
        
        try {
            const selectedRegion = document.getElementById('ospc_discovery_region').value;
            const sshUser = document.getElementById('ospc_ssh_user').value || 'ubuntu';
            const sshKey  = document.getElementById('ospc_ssh_key').value || '';
            // OSPC cloud credentials — required for live API scan
            const ospcUser   = (document.getElementById('ospc_cloud_user')    || {}).value || '';
            const ospcApiKey = (document.getElementById('ospc_cloud_key')     || {}).value || '';
            const ospcTenant = (document.getElementById('ospc_cloud_account') || {}).value || '';
            if (!ospcUser || !ospcApiKey || !ospcTenant) {
                logsEle.textContent = '[ERROR] Missing OSPC credentials.\nPlease fill in OSPC Username, API Key, and Account/Tenant ID before scanning.';
                document.getElementById('discovery-spinner').style.display = 'none';
                return;
            }
            const resp = await fetch('/api/agent1/run/discovery', { 
                method: 'POST', 
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    region:        selectedRegion,
                    ssh_user:      sshUser,
                    ssh_key:       sshKey,
                    ospc_username: ospcUser,
                    ospc_apikey:   ospcApiKey,
                    ospc_tenant:   ospcTenant
                }) 
            });
            const data = await resp.json();
            
            if (data.status === "started") {
                let pollInterval = setInterval(async () => {
                    try {
                        let logReq = await fetch('/discovery_log.txt?t=' + new Date().getTime());
                        if(logReq.ok) {
                            let text = await logReq.text();
                            logsEle.textContent = text;
                            logsEle.parentElement.scrollTop = logsEle.parentElement.scrollHeight;
                            
                            if(text.includes("Discovery complete!") || text.includes("Error:") || text.includes("Stopped")) {
                                clearInterval(pollInterval);
                                document.getElementById('discovery-spinner').style.display = 'none';
                                document.getElementById('import-topology-btn').style.display = 'inline-flex';
                                showToast("Discovery Complete!");
                                
                                try {
                                    const topResp = await fetch('/api/agent1/results/topology?t=' + new Date().getTime());
                                    if(topResp.ok) {
                                        const topData = await topResp.json();
                                        const tbody = document.getElementById('stage1-results-body');
                                        tbody.innerHTML = '';
                                        topData.nodes.forEach(n => {
                                            if(n.group === 'load_balancer') return;
                                            let ip = n.ips && n.ips.length > 0 ? n.ips[0] : "N/A";
                                            let os = n.os || "Unknown";
                                            let agg = [];
                                            if(n.packages) agg.push(...n.packages);
                                            if(n.runtimes) agg.push(...n.runtimes);
                                            if(n.env) agg.push(...n.env);
                                            if(n.services) agg.push(...n.services);
                                            let svcs = agg.length > 0 ? agg.join(", ") : "None Detected";
                                            let rowHTML = `<tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                                <td style="padding: 10px 5px;">${n.id}</td>
                                                <td style="padding: 10px 5px; font-family: 'Fira Code', monospace; color: #79c0ff;">${ip}</td>
                                                <td style="padding: 10px 5px;">${os}</td>
                                                <td style="padding: 10px 5px; color: #a5b4fc;">${n.group}</td>
                                                <td style="padding: 10px 5px;">${svcs}</td>
                                            </tr>`;
                                            tbody.insertAdjacentHTML('beforeend', rowHTML);
                                        });
                                        document.getElementById('stage1-results-container').style.display = 'block';
                                        populateNewStageTables(topData);
                                        populateResourceTabs(topData);
                                    }
                                } catch(e) {}
                            }
                        }
                    } catch(err) {}
                }, 1000);
            } else {
                logsEle.textContent += "Status: " + data.message;
                document.getElementById('discovery-spinner').style.display = 'none';
            }
        } catch(err) {
            logsEle.textContent += "Error: API Backend connection failed (is server pending start?).";
            document.getElementById('discovery-spinner').style.display = 'none';
        }
    });

    document.getElementById('import-offline-csv-btn').addEventListener('click', () => {
        document.getElementById('inventory-upload').click();
    });

    document.getElementById('inventory-upload').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if(!file) return;
        
        showToast("Uploading offline inventory CSV...");
        
        try {
            const buffer = await file.arrayBuffer();
            const resp = await fetch('/api/agent1/upload/inventory_csv', {
                method: 'POST',
                headers: {
                    'Content-Type': 'text/csv',
                    'Content-Length': buffer.byteLength.toString()
                },
                body: buffer
            });
            
            if(resp.ok) {
                showToast("CSV Uploaded & Parsed Successfully!");
                document.getElementById('import-topology-btn').style.display = 'inline-flex';
                
                try {
                    const topResp = await fetch('/api/agent1/results/topology?t=' + new Date().getTime());
                    if(topResp.ok) {
                        const topData = await topResp.json();
                        const tbody = document.getElementById('stage1-results-body');
                        tbody.innerHTML = '';
                        topData.nodes.forEach(n => {
                            if(n.group === 'load_balancer') return;
                            let ip = n.ips && n.ips.length > 0 ? n.ips[0] : "N/A";
                            let os = n.os || "Unknown";
                            let agg = [];
                            if(n.packages) agg.push(...n.packages);
                            if(n.runtimes) agg.push(...n.runtimes);
                            if(n.env) agg.push(...n.env);
                            if(n.services) agg.push(...n.services);
                            let svcs = agg.length > 0 ? agg.join(", ") : "None Detected";
                            let rowHTML = `<tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <td style="padding: 10px 5px;">${n.id}</td>
                                <td style="padding: 10px 5px; font-family: 'Fira Code', monospace; color: #79c0ff;">${ip}</td>
                                <td style="padding: 10px 5px;">${os}</td>
