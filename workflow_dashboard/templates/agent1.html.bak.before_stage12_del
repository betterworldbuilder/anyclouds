    // ═══════ FLEX DISCOVERY ═══════
    let flexDiscoveryData = null;

    async function startFlexDiscovery() {
        const authUrl = document.getElementById('flex_auth_url')?.value?.trim();
        const username = document.getElementById('flex_cloud_user')?.value?.trim();
        const password = document.getElementById('flex_cloud_key')?.value?.trim();
        const projectId = document.getElementById('flex_cloud_account')?.value?.trim();
        const domain = document.getElementById('flex_cloud_domain')?.value?.trim() || 'default';
        const region = document.getElementById('flex-discovery-region')?.value || 'IAD';
        
        if (!username || !password) {
            showToast('⚠️ Fill in FLEX Cloud Credentials (username + password) first!');
            return;
        }
        if (!authUrl) {
            showToast('⚠️ Auth URL is required! Import your OpenRC file or enter the Keystone v3 URL.');
            return;
        }
        
        const btn = document.getElementById('start-flex-discovery-btn');
        const console_el = document.getElementById('flex-discovery-console');
        const logEl = document.getElementById('flex-discovery-log');
        
        btn.disabled = true;
        btn.textContent = '⏳ Scanning FLEX...';
        console_el.style.display = 'block';
        logEl.textContent = `Starting FLEX Environment Discovery (Region: ${region})...\nAuthenticating with Keystone v3: ${authUrl}\n`;
        
        try {
            const resp = await fetch('/api/agent1/run/flex-discovery', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ auth_url: authUrl, username, password, project_id: projectId, domain, region })
            });
            
            const result = await resp.json();
            
            if (result.status === 'ok') {
                flexDiscoveryData = result.data;
                const d = result.data;
                logEl.textContent += `Authentication successful!\n`;
                logEl.textContent += `Found: ${d.servers.length} servers, ${d.networks.length} networks, ${d.load_balancers.length} LBs, ${d.volumes.length} volumes, ${d.databases.length} databases, ${d.stacks.length} stacks\n`;
                logEl.textContent += `FLEX Discovery complete!\n`;
                
                populateFlexTabs(result.data);
                buildMatchingTable();
                
                document.getElementById('flex-results-container').style.display = 'block';
                document.getElementById('ospc-flex-matching').style.display = 'block';
                
                btn.textContent = '✅ FLEX Discovery Complete';
                btn.style.background = 'rgba(16,185,129,0.2)';
                btn.style.border = '1px solid #10b981';
                showToast(`✅ FLEX Discovery: ${d.servers.length} servers, ${d.networks.length} networks found`);
            } else {
                logEl.textContent += `ERROR: ${result.error}\n`;
                btn.textContent = '❌ Discovery Failed';
                showToast('❌ FLEX Discovery failed: ' + result.error);
            }
        } catch(err) {
            logEl.textContent += `FETCH ERROR: ${err.message}\n`;
            btn.textContent = '❌ Discovery Failed';
            showToast('❌ FLEX Discovery error: ' + err.message);
        }
        
        setTimeout(() => { btn.disabled = false; btn.textContent = '🚀 Start FLEX Environment Discovery'; btn.style.background = ''; btn.style.border = ''; }, 5000);
    }

