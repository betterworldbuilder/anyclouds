            };
            
            if(!payload.ip) {
                showToast("Missing FLEX target IP address.");
                throw new Error("No IP");
            }
            
            let logDiv = document.getElementById(`verify-log-${normalized}`);
            if(logDiv) { logDiv.style.display = 'block'; logDiv.textContent = `Probing ssh ${payload.user}@${payload.ip}...\n`; }

