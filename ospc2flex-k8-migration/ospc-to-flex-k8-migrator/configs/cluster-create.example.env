# cluster-create.example.env
# Environment variables for Stage 2 — Create Flex Magnum Cluster.
# Copy to cluster-create.env and fill in your values.
# Source before running: source cluster-create.env

# ── OpenStack credentials ─────────────────────────────────────────────────────
# Point to your Rackspace Flex OpenRC file
export FLEX_OPENRC="${HOME}/openrc.sh"

# Or inline (less secure — prefer openrc file):
# export OS_AUTH_URL=https://identity.api.rackspacecloud.com/v3
# export OS_PROJECT_NAME=my-project
# export OS_USERNAME=my-rackspace-user
# export OS_PASSWORD=CHANGE_ME
# export OS_REGION_NAME=IAD
# export OS_USER_DOMAIN_NAME=Default
# export OS_PROJECT_DOMAIN_NAME=Default
# export OS_IDENTITY_API_VERSION=3

# ── Magnum cluster settings ───────────────────────────────────────────────────
export MAGNUM_CLUSTER_NAME=flex-k8s-production
export MAGNUM_TEMPLATE=k8s-1.27-ubuntu22-amd64      # openstack coe cluster template list
export MAGNUM_MASTER_COUNT=3
export MAGNUM_WORKER_COUNT=5
export MAGNUM_KEYPAIR=my-rackspace-keypair           # openstack keypair list

# ── Output ────────────────────────────────────────────────────────────────────
export FLEX_KUBECONFIG_OUT=./output/flex-kubeconfig

# ── Wait settings ─────────────────────────────────────────────────────────────
export MAGNUM_POLL_INTERVAL=30   # seconds between status polls
export MAGNUM_WAIT_TIMEOUT=3600  # max seconds to wait for CREATE_COMPLETE
