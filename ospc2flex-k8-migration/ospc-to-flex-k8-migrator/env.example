# env.example — Copy to .env and fill in your values.
# Source before running: source .env
# NEVER commit this file with real values.

# ── Stage 1: OSPC source cluster (SSH remote master) ─────────────────────────
export OSPC_MASTER_IP=10.x.x.x            # OSPC Kubernetes master node IP
export SSH_USER=centos                     # SSH username on the master
export SSH_KEY_PATH=~/.ssh/id_rsa          # Local path to SSH private key
export SSH_PORT=22                         # SSH port (default: 22)
export SSH_TIMEOUT=30                      # Connection timeout in seconds
export KUBECTL_TIMEOUT=300                 # kubectl command timeout (seconds)
export KEEP_REMOTE_EXPORT=false            # Set true to keep /tmp/ospc-k8-export-* on master
export REMOTE_TEMP_BASE=/tmp               # Remote temp dir base path

# ── Stage 2: Rackspace Flex OpenStack credentials ────────────────────────────
export FLEX_OPENRC="${HOME}/openrc.sh"     # Path to OpenRC credentials file

# ── Stage 2: Magnum cluster creation ─────────────────────────────────────────
export MAGNUM_CLUSTER_NAME=flex-k8s-prod
export MAGNUM_TEMPLATE=k8s-1.27-ubuntu22-amd64
export MAGNUM_MASTER_COUNT=3
export MAGNUM_WORKER_COUNT=5
export MAGNUM_KEYPAIR=my-keypair

# ── Stage 3+: Flex target cluster kubeconfig ──────────────────────────────────
export FLEX_KUBECONFIG=./output/flex-kubeconfig
export FLEX_CONTEXT=flex-magnum-production

# ── Output directories ────────────────────────────────────────────────────────
export OUTPUT_DIR=./output
export LOG_DIR=./output/logs

# ── Migration plan ────────────────────────────────────────────────────────────
export MIGRATION_PLAN=./configs/migration-plan.yaml
