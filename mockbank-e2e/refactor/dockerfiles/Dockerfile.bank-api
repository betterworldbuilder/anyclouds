# Generated by APPS to Container Refactor Engine — component: bank-api (CONTAINERIZED)
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn==22.0.0
COPY app.py .
ENV BANK_DB=/tmp/mockbank.db PORT=8000
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1
CMD ["gunicorn", "-b", "0.0.0.0:8000", "--workers", "2", "app:app"]
